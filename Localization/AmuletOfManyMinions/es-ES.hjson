			}

			Quizzes: {
				QuizWithDominantTraits: {
					IntroLines: {
						0: ¡Bienvenido al mundo de Terraria!
						1: Terraria puede ser un lugar peligroso, ¡pero tener un buen amigo a tu lado siempre lo hace mejor!
						2: Para ayudarte a ti y a tu nuevo amigo a conocerse mejor, ¡aquí van algunas preguntas!
						3: Asegúrate de responder con sinceridad. ¡Empecemos!
					}

					OutroLines: {
						0: ¡Gracias por responder esas preguntas!
						1: Según tus respuestas, pareces tener una naturaleza... ¡{0}!
						2: Alguien de naturaleza {0} como tú haría muy buena amistad con... ¡{1}!
						3: ¡Que tú y tu nuevo amigo disfruten de muchas aventuras!
					}
				}

				ClassSpecificQuiz: {
					IntroLines: {
						0: ¡Bienvenido de nuevo al mundo de Terraria!
						1: ¡Espero que tú y tus amigos hayan estado disfrutando de sus aventuras!
						2: ¿Sabes cuál es lo único mejor que tener amigos? ¡Tener más amigos!
					}

					OutroLines: {
						0: ¡Ah, será estupendo tener un amigo de naturaleza {0}!
						1: ¡{1} —con una personalidad {0}— se une a tu equipo con muchas ganas!
						2: ¡Que tú y tu nuevo amigo disfruten de muchas aventuras!
					}

					Text: ¿Qué tipo de amigo te gustaría que te acompañara en tu viaje?

					Answers: {
						0: ¡Un amigo con una pasión ardiente!
						1: ¡Un amigo que sabe dejarse llevar!
						2: ¡Un amigo con los pies en la tierra!
						3: ¡Un amigo con la cabeza en las nubes!
					}
				}
			}

			Questions: {
				0: {
					Text: Bien, pero ¿cuál es realmente tu clase favorita para jugar?

					Answers: {
						CALM: Invocador.
						QUIRKY: ¿Invocador?
						BOLD: ¡Invocador!
					}
				}

				1: {
					Text: ¿Cuál es tu clase favorita para jugar?

					Answers: {
						HARDY: Cuerpo a cuerpo.
						BOLD: A distancia.
						CALM: Mago.
					}
				}

				2: {
					Text: Le diste clic a Reforjar una vez de más por accidente, ¡y ahora tu Zenith Legendario está Roto! ¿Qué haces?

					Answers: {
						QUIET: Llorar.
						JOLLY: Seguir dándole a "Reforjar".
						QUIRKY: ¡Instalar Consistent Reforging!
					}
				}

				3: {
					Text: ¡El Sastre perdió su sombrero y dice que el Guía se lo robó! ¿Cómo ayudas?

					Answers: {
						QUIET: Dejar que lo resuelvan peleando.
						BOLD: Confrontar al Guía directamente.
						CALM: Intentar mediar.
					}
				}

				4: {
					Text: ¡Ves a un inocente Conejo siendo perseguido por un grupo de Duendes Exploradores! ¿Intervienes?

					Answers: {
						BOLD: Sí.
						CALM: No.
						JOLLY: ¡Perseguir al conejo también!
					}
				}

				5: {
					Text: Acabas de empezar un nuevo mundo. ¿Cómo le construyes una casa al Guía?

					Answers: {
						CALM: Una linda cabaña.
						QUIET: Un cubo prisión.
						HASTY: Ninguna casa.
					}
				}

				6: {
					Text: ¡Re-Logic acaba de nerfear tu arma favorita! ¿Cómo te adaptas?

					Answers: {
						HARDY: Seguir usándola.
						JOLLY: ¡Probar una nueva!
					}
				}

				7: {
					Text: ¿Prefieres construir o aventurarte?

					Answers: {
						RELAXED: Construir.
						BOLD: Aventurarme.
						QUIRKY: ¡Pescar!
					}
				}

				8: {
					Text: Después de saquear un cofre, ¿te llevas el cofre contigo?

					Answers: {
						HARDY: Sí.
						QUIRKY: No.
					}
				}

				9: {
					Text: Mientras exploras una cueva, ves un cofre del tesoro a plena vista.

					Answers: {
						QUIRKY: ¡Genial, un tesoro!
						HARDY: ¡Es un cofre falso!
						QUIET: ¡Es un cofre con trampa!
					}
				}

				10: {
					Text: ¿Cuál es tu color favorito?

					Answers: {
						BOLD: Rojo.
						CALM: Verde.
						JOLLY: Azul.
					}
				}

				11: {
					Text: ¿Qué tan organizados tienes tus cofres?

					Answers: {
						HASTY: Para nada.
						QUIRKY: Un poco.
						QUIET: Muy organizados.
					}
				}

				12: {
					Text: Acabas de llegar a la entrada del calabozo, ¡pero la noche ya va a la mitad! ¿Qué haces?

					Answers: {
						HASTY: ¡Pelear contra Skeletron de inmediato!
						HARDY: Construir primero una arena improvisada.
						RELAXED: Esperar hasta la noche siguiente
					}
				}

				13: {
					Text: ¡Una sonda marciana te tomó por sorpresa y ahora se aleja volando! ¿Cómo respondes?

					Answers: {
						QUIET: Guardar y salir rápidamente.
						HASTY: ¡Perseguirla!
						QUIRKY: ¡Genial! ¡Invasión Marciana!
					}
				}

				14: {
					Text: ¿Prefieres la comida dulce o la comida salada?

					Answers: {
						JOLLY: ¡Dulce!
						RELAXED: Salada.
					}
				}

				15: {
					Text: ¿Cuál es tu dificultad favorita para jugar?

					Answers: {
						RELAXED: Normal.
						HARDY: Experto.
						BOLD: Maestro.
					}
				}

				16: {
					Text: Estás jugando multijugador y encontraste un objeto único de un cofre. ¿Cómo manejas el hecho de compartirlo?

					Answers: {
						HASTY: El primero que llega, se lo lleva.
						RELAXED: Repartir el botín equitativamente.
					}
				}

				17: {
					Text: ¿Prefieres a los Escuderos o los látigos?

					Answers: {
						CALM: Escuderos.
						QUIET: ¿Escuderos?
						JOLLY: ¡Escuderos!
					}
				}

				18: {
					Text: ¿Replantas los árboles después de talarlos?

					Answers: {
						HASTY: ¡Nunca!
						CALM: De inmediato.
						RELAXED: Después de un tiempo.
					}
				}
			}

			ClassSpecificQuestions: {
				0: {
					Text: ¡Un amigo ardiente es una gran elección! ¿Cómo debería ser su carácter?

					Answers: {
						BOLD: ¡Extrovertido y audaz!
						QUIET: Reservado y callado.
					}
				}

				1: {
					Text: ¡Un amigo relajado es una gran elección! ¿Cómo debería ser su carácter?

					Answers: {
						JOLLY: ¡Alegre y despreocupado!
						QUIRKY: ¡Peculiar y excéntrico!
					}
				}

				2: {
					Text: ¡Un amigo con los pies en la tierra es una gran elección! ¿Cómo debería ser su carácter?

					Answers: {
						HARDY: ¡Fuerte y resiliente!
						CALM: Sereno y tranquilo.
					}
				}

				3: {
					Text: ¡Un amigo con la cabeza en las nubes es una gran elección! ¿Cómo debería ser su carácter?

					Answers: {
						RELAXED: ¡Relajado y despreocupado!
						HASTY: Apresurado y ambicioso.
					}
				}
			}

			NextButton.Text: Siguiente
		}

		TargetSelectionTactics: {
			AttackGroups: {
				DisplayName: Grupos de Ataque
				Description: Ataca a enemigos que estén cerca unos de otros
			}

			ClosestEnemyToMinion: {
				DisplayName: Enemigo Más Cercano al Súbdito
				Description: Ataca al enemigo más cercano al súbdito
			}

			ClosestEnemyToPlayer: {
				DisplayName: Enemigo Más Cercano al Jugador
				Description: Ataca al enemigo más cercano al jugador
			}

			LeastDamagedEnemy: {
				DisplayName: Enemigo Menos Dañado
				Description: Ataca al enemigo con la vida [c/FF0000:actual más alta]
			}

			MostDamagedEnemy: {
				DisplayName: Enemigo Más Dañado
				Description: Ataca al enemigo con la vida [c/FF0000:actual más baja]
			}

			SpreadOut: {
				DisplayName: Dispersarse
				Description: Cada súbdito ataca a un enemigo diferente si es posible
			}

			StrongestEnemy: {
				DisplayName: Enemigo Más Fuerte
				Description: Ataca al enemigo con la vida [c/FF0000:máxima más alta]
			}

			WeakestEnemy: {
				DisplayName: Enemigo Más Débil
				Description: Ataca al enemigo con la vida [c/FF0000:máxima más baja]
			}
		}

		TacticsGroups: {
			Description:
				'''
				Cada grupo de tácticas puede tener asignada una táctica y un punto de referencia distintos.
				Asigna el grupo de tácticas de un súbdito haciendo clic izquierdo en su ícono de mejora
				'''
			Sun: Grupo Sol
			Moon: Grupo Luna
			Both: Ambos Grupos
			Close: Cerrar Tácticas de Súbditos
			Open: Abrir Tácticas de Súbditos
		}

		DropConditions: {
			SlimepireCondition.Description: Cae durante una Luna de Sangre en Modo Difícil
			AnyLunarEventCondition.Description: Cae durante cualquier Evento Lunar
			NoLunarEventCondition.Description: No cae durante ningún Evento Lunar
			FirstBossDefeatedCondition.Description: Cae después de derrotar al primer jefe
		}

		Configs: {
			ClientConfig: {
				DisplayName: Configuración de Cliente

				Headers: {
					GeneralConfiguration: Configuración General
					TacticsConfiguration: Configuración de Tácticas
				}

				TacticsUIAnchor: {
					Label: Posición de Anclaje de la UI de Tácticas de Súbditos
					Tooltip: Elige entre anclar la UI al lado derecho del inventario, o al lado izquierdo de la vida/minimapa
				}

				QuickDefendHotkeyStyleNew: {
					Label: Estilo de Tecla de Defensa Rápida de Súbditos
					Tooltip: Elige si la Defensa Rápida de Súbditos se activa/desactiva con la tecla, o se activa mientras se mantiene presionada
				}

				ShowMinionVarietyBonus: {
					Label: Mostrar Bono de Variedad de Súbditos
					Tooltip: Si está activado, muestra el bono de variedad de súbditos actual del usuario en la descripción de una mejora
				}

				IgnoreVanillaTargetReticle: {
					Label: Las Tácticas Ignoran la Retícula de Objetivo de Súbditos Vanilla
					Tooltip:
						'''
						Si está activado, los súbditos ignorarán la retícula de objetivo de súbditos vanilla en favor del PNJ seleccionado por la táctica actual
						Nota: Esto no aplica a las retículas colocadas al golpear enemigos con un látigo
						'''
				}

				WhipRightClickTacticsRadial: {
					Label: Activar Menú Rápido de Tácticas de Látigo
					Tooltip:
						'''
						Si está activado, hacer clic derecho con un látigo abrirá el Menú Radial de Tácticas
						Nota: Puede interferir con el clic derecho de látigos añadidos por mods.
						'''
				}
			}

			ServerConfig: {
				DisplayName: Configuración de Servidor

				Headers: {
					TacticsConfiguration: Configuración de Tácticas
					BalanceConfiguration: Configuración de Balance
					CrossModCompatibility: Compatibilidad entre Mods
				}

				WhipsSetWaypoint: {
					Label: Los Látigos Establecen el Punto de Referencia de Tácticas
					Tooltip: Si está activado, golpear a un enemigo con un látigo moverá el punto de referencia de tácticas a ese enemigo.
				}

				SquiresSetWaypoint: {
					Label: Los Escuderos Cuerpo a Cuerpo Establecen el Punto de Referencia de Tácticas
					Tooltip: Si está activado, golpear directamente a un enemigo con un escudero moverá el punto de referencia de tácticas a ese enemigo.
				}

				SquireProjSetWaypoint: {
					Label: Los Escuderos a Distancia Establecen el Punto de Referencia de Tácticas
					Tooltip: Si está activado, golpear a un enemigo con un proyectil disparado por un escudero moverá el punto de referencia de tácticas a ese enemigo.
				}

				GlobalDamageMultiplier: {
					Label: Escala de Daño Global
					Tooltip: Escala el daño de cada objeto del mod por un porcentaje positivo o negativo. 100% = valor por defecto
				}

				OtherDamageMinionNerf: {
					Label: Anti-Sinergia de No-Súbditos
					Tooltip: Reduce el daño infligido por armas que no son de invocación mientras un súbdito está activo
				}

				MinionDamageSquireNerf: {
					Label: Anti-Sinergia de Súbdito/Escudero
					Tooltip: Reduce el daño de los súbditos en un porcentaje mientras un escudero está activo
				}

				SquireDamageMinionNerf: {
					Label: Anti-Sinergia de Escudero/Súbdito
					Tooltip: Reduce el daño del escudero en un porcentaje por *cada* súbdito activo
				}

				MinionsInnacurate: {
					Label: Los Súbditos Son Menos Precisos
					Tooltip: Si está activado, los súbditos dispararán con menos precisión y girarán con menos brusquedad al perseguir enemigos
				}

				SquireMinionSlot: {
					Label: Los Escuderos Ocupan un Espacio de Súbdito
					Tooltip: Si está activado, los escuderos ocuparán un espacio de súbdito
				}

				SquireSpecialsWithWhips: {
					Label: Permitir Especiales de Escudero Mientras se Usan Látigos
					Tooltip: Si está activado, los especiales de clic derecho del escudero pueden activarse mientras se sostiene un látigo
				}

				SquiresDealTagDamage: {
					Label: Los Escuderos Infligen Daño de Marca de Invocación
					Tooltip: Si está activado, los escuderos otorgarán un bono fijo de 10% de daño de marca de invocación
				}

				CombatPetsMinionSlots: {
					Label: Todas las Mascotas de Combate Ocupan un Espacio de Súbdito
					Tooltip: Si está activado, cada mascota de combate ocupará un espacio de súbdito. De lo contrario, la primera invocada es gratuita.
				}

				AllowMultipleCombatPets: {
					Label: Permitir Múltiples Mascotas de Combate
					Tooltip: Si está activado, los emblemas de mascota de combate de nivel más alto aumentarán la cantidad de mascotas que puedes controlar.
				}

				DisableSummonersShineAI: {
					Label: Summoner's Shine: Desactivar Cambios de IA
					Tooltip: Si está activado, desactiva los cambios de IA en los súbditos de este mod realizados por Summoner's Shine.
				}
			}

			TacticsUIAnchorType: {
				Tooltip: ""
				Health.Label: Vida
				Inventory.Label: Inventario
			}

			QuickDefendHotkeyStyleType: {
				Tooltip: ""
				Toggle.Label: Alternar
				Hold.Label: Mantener
			}

			Common.AcceptClientChanges: No eres el propietario del servidor, así que no puedes cambiar esta configuración
		}
	}
}
