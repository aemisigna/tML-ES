		CombatPetQuiz: {
			PersonalityTypes: {
				NONE: ninguna
				CALM: serena
				HARDY: fuerte
				QUIRKY: rara
				JOLLY: alegre
				QUIET: mansa
				BOLD: osada
				HASTY: activa
				RELAXED: plácida
			}

			QuizResults: {
				CALM: Cachorro de Planta
				HARDY: Tortuga Trufa
				QUIRKY: Ajolotito
				JOLLY: Caimancito
				QUIET: Topo Brasas
				BOLD: Gallina Brasas
				HASTY: Libélula Viverna
