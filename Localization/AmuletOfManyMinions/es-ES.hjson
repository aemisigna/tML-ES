Mods: {
	AmuletOfManyMinions: {
		SummonSpecialCompressed: {
			AbigailMinionItem: "{1} bloques de alcance de {$Mods.SummonersShine.Summon.RightClickSpecial}"
			ImpMinionItem: "{1} bloques de radio de explosión de {$Mods.SummonersShine.Summon.RightClickSpecial}"
		}

		SummonSpecial: {
			AbigailMinionItem:
				'''
				Cada invocación añade una Flor de Luto para acompañar a {$BuffName.AbigailMinion}
				¡Presiona {$Mods.SummonersShine.Summon.RightclickSpecialUncompressed} para que tus Flores de Luto invoquen periódicamente volutas dañinas!
				Las Flores de Luto pueden apuntar a enemigos dentro de {1} bloques
				{$Mods.SummonersShine.Summon.RequiresEnergy}
				'''
			ImpMinionItem:
				'''
				¡{$Mods.SummonersShine.Summon.RightclickSpecialUncompressed} para que tus diablillos se concentren en un objetivo con bolas de fuego explosivas!
				Las explosiones de las Bolas de Fuego Explosivas tienen un radio de {1} bloques
				{$Mods.SummonersShine.Summon.RequiresEnergy}
				'''
			AdamantiteSquireMinionItem: ¡Mientras justa, el Escudero de Adamantita inflige {1}x de daño!
			AncientCobaltSquireMinionItem: El Disparo Mágico viaja un {1}% de la distancia
			ArmoredBoneSquireMinionItem: Genera volutas a una tasa del {1}%
			BoneSquireMinionItem: La longitud del mangual es de {1} bloques
			CrimsonSquireMinionItem: El {$BuffName.Ichor} de {$ItemName.IchorFlask} dura {1} segundos
			DemonSquireMinionItem: Las Bolas de Fuego de Diablillo de la Habilidad Especial tienen un {1}% de velocidad
		}

		Items: {
			AmuletOfManyMinions: {
				DisplayName: Amuleto de Muchos Súbditos
				Tooltip:
					'''
					{$CommonItemTooltip.IncreasesMaxMinionsBy}
					Mejora enormemente el daño de invocación
					{$Common.Tooltips.IncreasesMinionVarietyBonusBy@1}
					'''
			}

			CharmOfManyMinions: {
				DisplayName: Talismán de Muchos Súbditos
				Tooltip:
