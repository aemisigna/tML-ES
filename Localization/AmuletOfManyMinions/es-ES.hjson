		Common: {
			AoMMVersion: (Versión de AoMM)
			ConcatenateTwo: "{0} {1}"

			Tooltips: {
				DecreasesMaxMinionsBy: Reduce tu número máximo de súbditos en {0}
				DecreasesMinionVarietyBonusBy: Reduce el bono de variedad de súbditos en un {0}%
				IncreasesMaxCombatPetsBy: Aumenta tu número máximo de mascotas de combate en {0}
				IncreasesMinionDamageBy: Aumenta el daño de invocación en un {0}%
				IncreasesMinionKnockbackByFlat: Aumenta el retroceso de los súbditos en {0}
				IncreasesSquireDamageBy: Aumenta el daño de escudero en un {0}%
				IncreasesMinionDamage: Aumenta el daño de invocación
				IncreasesMinionVarietyBonusBy: Aumenta el bono de variedad de súbditos en un {0}%
				IncreasesSquireTravelRangeBy: Aumenta el alcance de desplazamiento del escudero en {0} {^0:bloque;bloques}
				IncreasesSquireAttackSpeedBy: Aumenta la velocidad de ataque en un {0}% mientras usas un escudero
				IncreasesCombatPetMovementSpeed: Aumenta la velocidad de movimiento de la mascota de combate
				IgnoresEnemyDefense: Ignora {0} de defensa enemiga
				AllowsMinionAttackAroundCornersIn: Permite que tus súbditos ataquen automáticamente alrededor de esquinas en un radio de {0} bloques
				OccupiesPetSlots:
					'''

					Ocupa {0} espacios de Mascota de Combate
					'''
			}

			Replicas: {
				Replica: Réplica
				CommonTooltip:
					'''
					Cuentan las leyendas que solo un verdadero maestro es capaz de dominar el poder de esta mascota.
					¡Pero ahora tú también puedes, por un simple pago de 50 monedas de oro!
					'''
			}

			Squires: {
				SummonsASquire: Invoca a un Escudero
				ClickAndHold: Haz clic y mantén presionado para guiar sus ataques
				ClickAndHoldPlural: Haz clic y mantén presionado para guiar sus ataques
				RightClickSpecial: Especial de Clic Derecho: {0}
			}

			WaypointRods: {
				CommonTooltip:
					'''
					Herramienta
					¡Haz clic para colocar un punto de referencia de guía para súbditos!
					Los súbditos navegarán automáticamente hacia el punto de referencia
					Atacar con un arma que no sea de invocación disipa el punto de referencia
					Los súbditos infligen menos daño al atacar un punto de referencia lejano
					'''
				WaypointRange: Alcance de {0} bloques
			}

			CombatPetEmblems: {
				CommonTooltip:
					'''
					¡Un emblema que aumenta el poder de tus mascotas de combate!
					Mientras este objeto esté en tu inventario, tu mascota de combate infligirá
					daño adicional y recibirá un bono a la velocidad de movimiento y al alcance de ataque.
					'''
				MinionSlotsToCombatPet: Además, puedes usar hasta {0} de tus espacios de súbditos en mascotas de combate.
			}

			CombatPets: {
				CommonDescription:
					'''
					¡El espíritu de lucha de esta mascota ha despertado!
					Puede potenciarse llevando un Emblema de Mascota de Combate.
					'''
				NotLeveledUp:
					'''
					¡Esta mascota obtendrá un patrón de ataque más fuerte si llevas un
					{0} o algo más fuerte!
					'''
				LeveledUp: ¡Tu emblema activa el patrón de ataque más fuerte de esta mascota!
			}

