	SoulCatalyst: {
		DisplayName: Catalizador de Alma
		Tooltip: Una estrella marchita con el poder de manifestar recuerdos en reliquias olvidadas hace mucho tiempo.
	}

	JusticeDecree: {
		DisplayName: Decreto de Justicia
		Tooltip:
			'''
			[c/FFFF00:Un decreto forjado en fuego justiciero.]
			[c/FFFF00:Requiere el Rasgo de Alma JUSTICIA.]
			[c/FFFF00:+6 puntos de inversión de Justicia]
			[c/FFFF00:Al usar cualquier salto doble, coloca hasta 6 marcas en enemigos cercanos.]
			[c/FFFF00:Cada disparo se dirige a la siguiente marca con un rayo de Justicia teledirigido. Tus invocaciones se centrarán en los enemigos golpeados.]
			[c/FFFF00:Todos los golpes contra enemigos marcados son críticos garantizados, y la probabilidad de golpe crítico se convierte en probabilidad de -Hipercrítico-.]
			[c/FFFF00:Los hipercríticos infligen 3x de daño en lugar de 2x.]
			'''
	}

	SixShooter: {
		DisplayName: Revólver de seis tiros
		Tooltip:
			'''
			[c/FFFF00:Seis recámaras. Sin apelaciones.]
			[c/FFFF00:Requiere el Rasgo de Alma JUSTICIA.]
			[c/FFFF00:+8 puntos de inversión de Justicia]
			[c/FFFF00:Dispara rayos de Justicia que siempre asestan golpes críticos.]
			[c/FFFF00:La probabilidad de golpe crítico se convierte en probabilidad de -Hipercrítico-.]
			[c/FFFF00:Puede disparar hasta 6 veces antes de necesitar recargar.]
			[c/FFFF00:Haz clic derecho para disparar rayos en abanico muy imprecisos al doble de velocidad.]
			[c/FFFF00:El salto doble recarga automáticamente el cilindro.]
			'''
	}

	RealKnife: {
		DisplayName: Cuchillo real
		Tooltip:
			'''
			[c/FF0000:Una hoja forjada a partir de DETERMINACIÓN.]
			[c/FF0000:Requiere el Rasgo de Alma DETERMINACIÓN.]
			[c/FF0000:+6 puntos de inversión de Determinación]
			[c/FF0000:Los ataques cuerpo a cuerpo restauran 20 de maná.]
			[c/FF0000:Haz clic derecho para consumir 200 de maná y comenzar un ataque cronometrado.]
			[c/FF0000:Alinea el marcador con el centro para infligir hasta 15x de daño con el tajo a distancia.]
			'''
	}

	TrueKnife: {
		DisplayName: Cuchillo verdadero
		Tooltip:
			'''
			[c/FF0000:Por fin.]
			[c/FF0000:Requiere el Rasgo de Alma DETERMINACIÓN.]
			[c/FF0000:+8 puntos de inversión de Determinación]
			[c/FF0000:Los ataques cuerpo a cuerpo restauran 20 de maná y liberan proyectiles de Determinación.]
			[c/FF0000:Haz clic derecho para comenzar un ataque cronometrado.]
			[c/FF0000:Alinea el marcador con el centro para infligir hasta 15x de daño con un enorme tajo cuerpo a cuerpo.]
			'''
	}

	SpecialistsNotebook: {
		DisplayName: Cuaderno del especialista
		Tooltip:
			'''
			[c/FF00FF:Las palabras tienen poder, refinadas y enfocadas.]
			[c/FF00FF:Requiere el Rasgo de Alma PERSEVERANCIA.]
			[c/FF00FF:+6 puntos de inversión de Perseverancia]
			[c/FF00FF:Dispara las letras guardadas en tu libro. Cada letra cuesta 12 de maná.]
			[c/FF00FF:Gastar maná en letras retrasa brevemente la regeneración de maná.]
			[c/FF00FF:Mientras estás en sigilo de pícaro: las letras cuestan la mitad de maná.]
			[c/FF00FF:Haz clic derecho para escribir en el libro. Algunas palabras tienen efectos especiales.]
			[c/FF00FF:Palabras nuevas: SPLIT, PARTITION, BURST, BURROW.]
			'''
	}

	TheAbstract: {
		DisplayName: El Resumen
		Tooltip:
			'''
			[c/A050FF:Todo artículo que valga la pena tiene un resumen.]
			[c/A050FF:Requiere el Rasgo de Alma PERSEVERANCIA.]
			[c/A050FF:+8 puntos de inversión de Perseverancia]
			[c/A050FF:Dispara las letras guardadas en tu libro. Cada letra cuesta 5 de maná.]
			[c/A050FF:Gastar maná en letras retrasa brevemente la regeneración de maná.]
			[c/A050FF:Mientras estás en sigilo de pícaro: las letras cuestan la mitad de maná.]
			[c/A050FF:Haz clic derecho para escribir en el libro. Algunas palabras tienen efectos especiales.]
			[c/A050FF:Palabras nuevas: HEAL, AURA, RAIN.]
			'''
	}

	JevilBossBag: {
		DisplayName: Bolsa del tesoro (Jevil)
		Tooltip: ""
	}

	KnightBossBag: {
		DisplayName: Bolsa del tesoro (Caballero Rugiente)
		Tooltip: ""
	}

	TitanBossBag: {
		DisplayName: Bolsa del tesoro (Titán)
		Tooltip: ""
	}

	FloweyBossBag: {
		DisplayName: Bolsa del tesoro (Flowey)
		Tooltip: ""
	}

	ForthcomingWrath: {
		DisplayName: Ira inminente
		Tooltip:
			'''
			Una guja que corta el aire en rápida sucesión.
			Cada golpe despliega tres hojas en un cono amplio.
			Cada 9 golpes carga un Golpe inminente que inflige Azote de Titanes durante 10 segundos.
			'''
	}

	LodestoneFork: {
		DisplayName: Horquilla de magnetita
		Tooltip:
			'''
			Dispara fragmentos magnéticos que atraviesan bloques y perforan enemigos.
			Los fragmentos duran 5 segundos; cada enemigo golpeado tiene un enfriamiento de perforación de 1 segundo.
			Los golpes furtivos despliegan un magnetizador de magnetita
			El magnetizador se adhiere a bloques, enemigos o jugadores aliados.
			Los fragmentos cercanos son atraídos hacia él en un campo electromagnético crepitante.
			'''
	}

	TitansBaneFlask: {
		DisplayName: Frasco de Azote de Titanes
		Tooltip:
			'''
			Imbuye los ataques cuerpo a cuerpo con Azote de Titanes.
			Compatible con el Perol.
			'''
	}

	Titansblood: {
		DisplayName: Sangre de Titanes
		Tooltip: "'La sangre vital de un Titán, todavía caliente.'"
	}

	Devilsknife: {
		DisplayName: Cuchilladiablo
		Tooltip:
			'''
			"¡Soy un comodín!"
			Lanza una guadaña giratoria que regresa a ti.
			Los golpes generan un proyectil aleatorio de palo contra los enemigos
			Los golpes furtivos lanzan cuatro guadañas arqueadas
			'''
	}

	Soulflicker: {
		DisplayName: Destello de Alma
		Tooltip:
			'''
			"Aún queda dentro una brasa tenue."
			Aumenta permanentemente la inversión de Alma en 3
			Solo se puede consumir una vez
			'''
	}

	AceOfSpades: {
		DisplayName: As de picas
		Tooltip:
			'''
			"¿Es un 1 o un 11?"
			Convierte las balas de mosquete en proyectiles perforantes de pica
			Las picas pueden atravesar hasta tres enemigos
			'''
	}

	QueenOfDiamonds: {
		DisplayName: Reina de diamantes
		Tooltip:
			'''
			"Te vencerá si puede."
			Los golpes de látigo ordenan a tus súbditos atacar
			Cada súbdito dispara un diamante al objetivo golpeado
			Hasta 5 diamantes por golpe
			'''
	}

	KingOfHearts: {
		DisplayName: Rey de corazones
		Tooltip:
			'''
			"¡Que les corten la cabeza!"
			Mantén pulsado para invocar hasta 10 corazones en órbita
			Cada corazón cuesta 25 de maná
			Suelta para enviar el enjambre de corazones hacia el cursor
			'''
	}

	DeckOfCards: {
		DisplayName: Mazo de cartas
		Tooltip:
			'''
			+0.5 de suerte
			+4% de probabilidad de golpe crítico
			Golpear a los enemigos crea una carta sobre tu cabeza
			Con 5 cartas, desata un ataque de palo basado en tu mano de póquer
			La estadística de 'Suerte' mejora las probabilidades de obtener mejores manos
			Solo puedes obtener cartas una vez por segundo
			'''
	}

	OopsAllCrits: {
		DisplayName: Ups, todo son críticos
		Tooltip:
			'''
			+0.15 de suerte
			+45% de probabilidad de golpe crítico
			-22% de daño total
			'''
	}

	JackOfClubs: {
		DisplayName: Sota de tréboles
		Tooltip:
			'''
			"Lárgate."
			Golpea el suelo para crear una onda de choque de tréboles
			Los golpes directos lanzan a los enemigos por los aires
			Su enorme peso te arrastra con él
			'''
	}

	Cascade: {
		DisplayName: Cascada
		Tooltip:
			'''
			Una ballesta de poder destructivo inmenso.
			Convierte todas las flechas en un proyectil de alta velocidad que se adhiere a cualquier superficie o enemigo.
			El proyectil atrae a los enemigos cercanos hacia él y después detona, infligiendo un daño enorme.
			Mientras está adherido, invoca desde lejos 8 copias de las flechas cargadas.
			Consume 3 flechas por disparo.
			'''
	}

	ShatteredGlass: {
		DisplayName: Vidrio roto
		Tooltip:
			'''
			Dispara un rayo azul oscuro de luz fracturada.
			Los golpes crean fragmentos de vidrio alrededor de los enemigos durante un breve periodo.
			Los golpes posteriores rebotan entre los fragmentos e infligen daño adicional.
			'''
	}

	Leyline: {
		DisplayName: Línea Ley
		Tooltip:
			'''
			Un látigo que se comporta como un gancho de agarre viviente.
			Se engancha a los enemigos o al cursor y te atrae gradualmente.
			Los enemigos que tocan la atadura reciben daño repetidamente.
			Suelta mientras estás enganchado a un enemigo para infligir hasta 10x de daño.
			Este daño de liberación alcanza su máximo después de estar adherido durante 2 segundos.
			'''
	}

	TitansArrow: {
		DisplayName: Flecha de Titán
		Tooltip:
			'''
			Se adhiere al primer objetivo o superficie que golpea.
			Inflige un 20% de daño al impactar y después explota para infligir el 80% restante tras 1 segundo.
			'''
	}

	Appendage: {
		DisplayName: Apéndice
		Tooltip:
			'''
			El agarre de Titán, ahora bajo tu mando.
			Invoca dos manos de Titán que te flanquean.
			Las manos disparan periódicamente devastadores láseres contra los enemigos cercanos.
			Los objetivos marcados por el látigo tienen prioridad.
			Ocupa dos espacios de súbdito. Solo se puede invocar un par.
			'''
	}

	TitanicEmblem: {
		DisplayName: Emblema titánico
		Tooltip:
			'''
			El peso de un Titán detrás de cada golpe.
			+112% de tamaño de arma cuerpo a cuerpo verdadera.
			+10% de daño de arma cuerpo a cuerpo verdadera.
			+66% de retroceso de arma cuerpo a cuerpo verdadera.
			-25% de velocidad de ataque de arma cuerpo a cuerpo verdadera.
			'''
	}

	TitanStar: {
		DisplayName: Estrella de Titán
		Tooltip: Invoca una estrella radiante para iluminar tu camino.
	}
}

Tiles: {
	DarkPortal.MapEntry: Portal Oscuro
	TitanForge.MapEntry: Forja de Titán
	SoulStation.MapEntry: Estación de Alma
