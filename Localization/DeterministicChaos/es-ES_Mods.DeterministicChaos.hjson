	SuspiciousEye: {
		DisplayName: ¿Ojo sospechoso...?
		Tooltip: Este ojo parece un poco más sospechoso de lo normal.
	}

	SixHumanSouls: {
		DisplayName: Seis Almas Humanas
		Tooltip: Otorga permanentemente +20 de inversión de Alma, 50 de vida y 5 de defensa.
	}

	PhotoshopSword: {
		DisplayName: '''"Espada de hierba"'''
		Tooltip: Envenena a los enemigos al golpear directamente.
	}

	PhotoshopGun: {
		DisplayName: '''"Minitiburón"'''
		Tooltip:
			'''
			Reemplaza las balas de mosquete por dientes de tiburón que aplican una hemorragia rápida.
			Usa el fuego alternativo para dar una mordida a corta distancia que otorga penetración de armadura contra el enemigo golpeado.
			"Este es de un tamaño bastante considerable, la verdad."
			'''
	}

	PhotoshopMissile: {
		DisplayName: '''"Proyectil mágico"'''
		Tooltip:
			'''
			Dispara un misil buscador que sigue al cursor.
			"Esto no tiene mucha magia..."
			'''
	}

	PhotoshopWhip: {
		DisplayName: '''"Latigazo espinal"'''
		Tooltip:
			'''
			{0} / {1}% de daño de marca de invocación
			Dispara un cráneo en la punta que aplica daño de marca plano.
			Los golpes con el cuerpo del látigo aplican una bonificación porcentual de daño de marca.
			"Esto llega hasta doce."
			'''
	}

	PhotoshopBall: {
		DisplayName: '''"Bola de dientes"'''
		Tooltip: Lanza una bola de carne que explota en dientes. Los golpes furtivos disparan más dientes y dejan una explosión persistente.
		TooltipCalamity:
			'''
			Lanza una bola de carne que explota en dientes.
			Los golpes furtivos disparan más dientes y dejan una explosión persistente.
			'''
	}

	PhotoshopLicense: {
		DisplayName: Licencia de Photoshop
		Tooltip:
			'''
			Aumenta el realismo de Terraria 10 veces.
			Aplica corrección de color profesional, formato panorámico cinematográfico, destellos de lente y una cantidad costosa de iluminación dramática.
			'''
	}

	FirstKnife: {
		DisplayName: Primer cuchillo
		Tooltip:
			'''
			Libera cinco cuchillos que se dividen, vuelven a reunirse y estallan en Fragmentos de Malicia buscadores.
			Los Fragmentos de Malicia aplican Malicia, acumulándose hasta 20 veces en cada enemigo.
			Los golpes furtivos liberan más cuchillos y convierten cada convergencia en un tajo rojo que escala con la Malicia.
			'''
		TooltipCalamity:
			'''
			Libera cinco cuchillos de pícaro que se dividen, vuelven a reunirse y estallan en Fragmentos de Malicia buscadores.
			Los Fragmentos de Malicia aplican Malicia, acumulándose hasta 20 veces en cada enemigo.
			Los golpes furtivos liberan más cuchillos y convierten cada convergencia en un tajo rojo que escala con la Malicia.
			'''
	}

	DevilsKey: {
		DisplayName: Llave del Diablo
		Tooltip:
			'''
			Una llave hecha de luz y oscuridad.
			Invoca a Jevil.
			'''
	}

