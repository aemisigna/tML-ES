AceOfClubs: {
	DisplayName: As de Tréboles
	Tooltip: Los golpes críticos hacen que los enemigos suelten dinero
}

AceOfDiamonds: {
	DisplayName: As de Diamantes
	Tooltip:
		'''
		Los golpes críticos tienen una probabilidad de soltar Ases de Diamantes
		Los ases de diamantes aumentan tu daño en un 20% durante 5 segundos al recogerlos
		'''
}

AceOfHearts: {
	DisplayName: As de Corazones
	Tooltip: Los golpes críticos tienen una probabilidad de soltar corazones
}

AceOfSpades: {
	DisplayName: As de Picas
	Tooltip: Los golpes críticos infligen daño adicional.
}

DiamondAce: {
	DisplayName: As de Diamantes
	Tooltip: No deberías ver esto
}

FourOfAKind: {
	DisplayName: Póquer
	Tooltip:
		'''
		Los golpes críticos infligen daño adicional y sueltan dinero
		Los golpes críticos tienen una probabilidad de soltar un as de diamantes o un corazón
		'''
}

AssassinMagazine: {
	DisplayName: Cargador del Asesino
	Tooltip:
		'''
		Pulsa dos veces {0} mientras sostienes un arma a distancia para cambiar el tipo de munición
		Funciona mientras está en el inventario
		'''
}

Bauble: {
	DisplayName: Adorno Invernal
	Tooltip:
		'''
		Aumenta las capacidades defensivas y de movimiento cuando tienes menos de la mitad de la vida
		Al bajar de la mitad de la vida, crea un escudo que anula proyectiles durante 6 segundos
		1 minuto de enfriamiento
		'''
}

BowSummonItem: {
	DisplayName: Arco de Jinx
	Tooltip:
		'''
		Invoca un arco poseído para que luche por ti
		Usa la primera flecha de tu inventario
		Si no tienes flechas, dispara Flechas de Bufón más débiles de forma infinita
		El arco no ocupa ranuras de súbdito
		'''
}

ChaosCrystal: {
	DisplayName: Cristal del Caos
	Tooltip: Al recibir daño, tienes una probabilidad de teletransportarte a algún lugar cercano
}

CimmerianScepter: {
	DisplayName: Cetro Cimerio
	Tooltip:
		'''
		Invoca un cetro mágico para que luche por ti
		El cetro usa multitud de ataques contra los enemigos
		Este cetro no ocupa ranuras de súbdito
		'''
}

CleftHorn: {
	DisplayName: Cuerno Hendido
	Tooltip:
		'''
		Aumenta la penetración de armadura en 3
		Los ataques cuerpo a cuerpo ocasionalmente golpean dos veces a los enemigos
		'''
}

CultistScarf: {
	DisplayName: Bufanda de Tejido Ancestral
	Tooltip:
		'''
		Reduce el uso de maná en un 20% cuando tienes menos de la mitad de la vida
		Aumenta el maná máximo en 120 cuando tienes más de la mitad de la vida
		Aumenta la probabilidad de ataque crítico mágico en un 9%
		Los ataques mágicos ocasionalmente liberan rayos de poderosa Magia Antigua que rebotan en las paredes
		'''
}

CursedPendant: {
	DisplayName: Colgante Maldito
	Tooltip:
		'''
		Aumenta el daño cuerpo a cuerpo en un 6%
		Las armas tienen un 15% de probabilidad de infligir Infierno Maldito
		'''
}

DarkfeatherVisage: {
	DisplayName: Rostro de Pluma Oscura
	Tooltip:
		'''
		Aumenta el daño mágico y de invocación en un 7%
		Otorga una bonificación al llevarlo con una túnica mágica o un abrigo de piel
		'''
}

Dartboard: {
	DisplayName: Diana
	Tooltip:
		'''
		Reduce el daño recibido en un 13%
		Aumenta la probabilidad de ataque crítico en un 15%
