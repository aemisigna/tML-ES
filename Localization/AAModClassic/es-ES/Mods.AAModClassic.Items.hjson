LovecraftiansResearchList: {
	DisplayName: Lista de Investigación del Lovecraftiano
	Tooltip:
		'''
		¡Necesito estas cosas, por favor!
		1. Algo de esa biosfera subterránea. Un cristal de allí podría servir...
		2. Muestras de carne de la Corrupción. Quiero ver de qué están hechas esas cosas.
		3. Una muestra de hueso del Carmesí. Me pregunto cómo funciona su estructura ósea.
		4. Averigua de qué se alimentan las criaturas del Cenagal. Solo mátalas hasta que alguna deje caer su comida o algo así.
		5. Una escama de algo del Infierno. Intento descubrir cómo es que estas cosas resisten tanto el fuego.
		6. Muestras de esporas de la Jungla. Estos hongos son muy molestos; quizá pueda crear algo para acabar con ellos.
		7. Alguna parte de criatura que inyecte veneno o algo parecido. Se me rompió la jeringa y esa enfermera no me deja usar ninguna de las suyas.
		8. Una muestra de aquello de lo que están hechos el Monarca de los Hongos y el Hongo Feudal. Aunque quizá necesite ayuda para estudiarlos...
		9. Un trozo de chatarra de esas islas flotantes al oeste de aquí. Parece un material interesante para fabricar equipo.
		10. Una máquina de hielo estaría bastante bien.
		11. Conejos. No para hacer pruebas; simplemente me parecen tiernos y quiero un par como mascotas.
		12. Algo brillante del Sagrado. Me pregunto si podría usarlo para preparar más pociones...
		'''
}

MadnessMushroom: {
	DisplayName: Hongo de la Locura
	Tooltip:
		'''
		Un hongo extremadamente raro
		¿Quizá Mushman sepa qué hacer con él?
		'''
}

GravitySphere: {
	DisplayName: Esfera Gravitacional
	Tooltip: ¡Un modelo de piedra del planeta, con una luna orbitando!
}

StarChart: {
	DisplayName: Carta Estelar
	Tooltip: Un mapa del sistema solar hasta este planeta.
}

WormIdol: {
	DisplayName: Ídolo Gusano
	Tooltip:
		'''
		Una estatua antigua que representa algún tipo de dios gusano.
		Parece que nadie la ha tocado en años
		'''
}

GS: {
	DisplayName: G S
	Tooltip: ""
}

SC: {
	DisplayName: S C
	Tooltip: ""
}

GlitchFish: {
	DisplayName: Pez con Fallos
	Tooltip: ""
}

Lore: {
	Calamity: {
		MushroomMonarchLore: {
			DisplayName: Monarca de los Hongos
			Tooltip: ""
			Lore:
				'''
				Hasta los seres más simples tienen sus reyes.
				Por razones que no pretendo conocer, los hongos de Terraria buscan expandir su alcance sin fin. 
				Con líderes tan débiles como este, no sorprende que no lo hayan logrado, incluso con las ventajas que mi cruzada podría haberles proporcionado.
				'''
		}

		FeudalFungusLore: {
			DisplayName: Hongo Feudal
			Tooltip: ""
			Lore:
				'''
				A pesar del espantoso control que pueden ejercer, sería deshonesto decir que no encuentro fascinante su naturaleza.
				Si mi cruzada hubiera terminado como debía y mi relación con el ingeniero no se hubiera desvanecido, le habría pedido que estudiara las propiedades mágicas del hongo.
				'''
		}

		GripsOfChaosLore: {
			DisplayName: Garras del Caos
			Tooltip: ""
			Lore:
				'''
				Estas extrañas manos son algo habitual entre mis exploradores.
				Desconozco su naturaleza, pero supongo que están relacionadas con el malvado caos que se cierne sobre Terraria.
				Una cosa sí sé con certeza: los dioses no son lo único que profana esta tierra.
				'''
		}

		TruffleToadLore: {
			DisplayName: Sapo Trufa
			Tooltip: ""
			Lore:
				'''
				Otra muestra de la tenacidad del hongo y de su negativa a dejar descansar a los muertos.
				Con el tiempo, he aprendido que estas demostraciones de poder no son más que intentos desesperados de los débiles por alcanzar la fuerza.
				'''
		}

		BroodmotherLore: {
			DisplayName: La Progenitora
			Tooltip: ""
			Lore:
				'''
				Qué criatura tan curiosa, nacida de ese caos infernal; es una pena verla muerta.
				Ya había conocido a su hija; es una relación extraña, pero aprendí a tratarla con respeto.
				A partir de ahora, tendré cuidado.
				'''
		}

		HydraLore: {
			DisplayName: La Hidra
			Tooltip: ""
			Lore:
				'''
				El Cenagal áspero y caótico al que llama hogar fue en otro tiempo un asentamiento de gran renombre.
				Eran mis partidarios más fervientes, y su destrucción fue una tragedia que no pude evitar.
				Dios o no, quienquiera que sea responsable algún día conocerá mi ira.
				'''
		}

		DesertDjinnLore: {
			DisplayName: Djinn del Desierto
			Tooltip: ""
			Lore:
				'''
				En la Era de los Dragones, el Mar Ilmerano no era más que un desierto azotado por la arena y el hogar de una casta abandonada.
				La mano de mi Cruzada lo restauró.
				Ahora, los espíritus de aquella civilización olvidada despiertan de su sueño ahogado por el agua.
				Un giro del destino bastante extraño, ¿no crees?
				'''
		}

		SubzeroSerpentLore: {
			DisplayName: Serpiente Subcero
			Tooltip: ""
			Lore:
				'''
				Pobre criatura.
				Parece que se ha debilitado a medida que la esencia divina y las fuerzas caóticas invaden su hábitat.
				Ambas son plagas que deben ser erradicadas si este mundo ha de conocer la paz algún día.
				'''
		}

		SagittariusLore: {
			DisplayName: Sagittarius
			Tooltip: ""
			Lore:
				'''
				Esas islas siniestras... Desde hace mucho tiempo fascinan a Draedon.
				Muchos de mis investigadores, bajo su mando, han estudiado la anomalía que las rodea.
				Y, aun así, han aprendido muy poco...
				El constructo al que te enfrentaste tiene una construcción única en comparación con los demás que hemos observado.
				Hay otros que buscan comprender la naturaleza de esta anomalía; quizá tengan un papel que desempeñar en todo esto.
				'''
		}

		SiegeUnitsLore: {
			DisplayName: Las Unidades de Asedio
			Tooltip: ""
			Lore:
				'''
				Qué constructos tan ridículos; sin duda son obra de los Fulgurianos.
				Antes eran un único ser, la Elemental de Tormenta, aunque hace mucho tiempo se separaron para formar una organización más grande.
				Sus intentos de innovar son ridículos; incluso estas máquinas defectuosas reflejan claramente que se inspiraron en los propios fracasos de Draedon.
				Sin duda, su arrogancia será su perdición.
				'''
		}

		OrthrusXLore: {
			DisplayName: Orthrus X
			Tooltip: ""
			Lore:
				'''
				¿De verdad esta tosca maquinaria es la última línea de defensa de los Fulgurianos?
				Qué patético.
				No me cabe duda de que mis Caballeros Buscadores de Dioses podrían reducirla a poco más que chatarra sin esfuerzo.
				'''
		}

		RaiderUltimaLore: {
			DisplayName: Raider Ultima
			Tooltip: ""
			Lore:
				'''
				Había oído rumores sobre esta Unidad de Asedio.
				Algunos miembros de mi infantería han sido derrotados por ella en varias ocasiones.
				Al verte acabar con ella... Está claro que mis soldados se han ablandado durante mi ausencia.
				'''
		}

		RetrieverLore: {
			DisplayName: El Retriever
			Tooltip: ""
			Lore:
				'''
				Construir una unidad de recuperación con forma de mano... Es casi lamentable.
				A pesar de su diseño deficiente, sin duda es capaz de entrar en la anomalía.
				No me cabe duda de que la intromisión de los Fulgurianos en aquello que no comprenden solo puede acabar mal.
				'''
		}

		AnubisLore: {
			DisplayName: El Escriba Legendario
			Tooltip: ""
			Lore:
				'''
				Hasta hace poco, solo había oído los mitos que murmuraban mis Caballeros del Escriba Legendario.
				Después de la Gran Incineración, me sorprendió encontrarlo ante mi corte, en carne y hueso.
				Emitió una advertencia: alguien se alzaría para poner fin a mi reinado.
				Parece que ve en ti el medio para destruirme.
				Solo el tiempo dirá cómo termina esta fábula...
				'''
		}

		AthenaLore: {
			DisplayName: Athena
			Tooltip: ""
			Lore:
				'''
				Una cohorte bastante peculiar; antes de la Caída, los serafines solían mezclarse con los Crisadianos.
				Ahora se han convertido en ermitaños reservados que dependen de la protección de su Reina.
				Si esto es todo en lo que se han convertido los Antiguos, estoy profundamente decepcionado.
				'''
		}

		GreedLore: {
			DisplayName: Avaricia
			Tooltip: ""
			Lore:
				'''
				¿Qué es esto...? ¿Otro gusano como... él?
				Imposible; todos fueron purgados, salvo el Devorador, porque escapó hacia un--
				...hmm... ¿y si no era el único con esa habilidad...?
				'''
		}

		RajahRabbitLore: {
			DisplayName: Rajah, el Conejo
			Tooltip: ""
			Lore:
				'''
				Un noble guerrero, Rajah es un rival digno.
				Durante mi conquista, me desafió por la misma razón por la que te buscó; acepté su invitación y lo derroté en un duelo.
				Sobrevivió gracias a su pura determinación, me desafió una vez más y llegamos a entendernos.
				No éramos tan distintos: vengadores de los caídos injustamente. Nuestro vínculo se hizo más fuerte y nuestras espadas chocaron muchas veces más.
				Draedon afirmó una vez que era un espía que estudiaba mis movimientos para matarme algún día, pero se equivocaba. Nunca podría entender el respeto mutuo entre dos rivales.
				Aunque nos hemos distanciado, lo conozco bien: esto estuvo muy lejos de mostrar todo el alcance de su poder. Agradece que haya sido misericordioso y espera que no desate toda su furia contra ti.
				'''
		}

		ForsakenAnubisLore: {
			DisplayName: Juez Abandonado, Anubis
			Tooltip: ""
			Lore:
				'''
				Así que Anubis decidió mostrarte un atisbo de lo que es capaz de hacer en realidad.
				Cuando decidió enfrentarse a mí, sin duda estaba en su máximo poder.
				Aun así, no sentí miedo. Esto no fue nada comparado con el poder que presencié al enfrentarme al Traidor Todopoderoso.
				Tendrás que hacerte aún más fuerte si esperas estar a mi altura.
				'''
		}

		OlympianAthenaLore: {
			DisplayName: Athena Olímpica
			Tooltip: ""
			Lore:
				'''
				Había pensado que era posible que Athena se hubiera contenido en tu primer enfrentamiento.
				Así que este es el verdadero poder de un Varian... El tiempo ha diezmado a los de su especie, pero aún les queda fuerza para luchar.
				Me pregunto, si hubieran ayudado a los Dragones en su batalla final, ¿habría escrito el destino una historia diferente...?
				'''
		}

		WormKingGreedLore: {
			DisplayName: Rey Gusano, Avaricia
			Tooltip: ""
			Lore:
				'''
				Mi hipótesis ha quedado demostrada...
				No cabe duda. Ese gusano dorado es, en efecto, pariente del Devorador.
				Pero si eso es cierto, entonces...
				¿Desde hace cuánto tiempo los de la estirpe de la Distorsión han estado influyendo en estas tierras...?
				'''
		}

		EquinoxWormsLore: {
			DisplayName: Los Gusanos del Equinoccio
			Tooltip: ""
			Lore:
				'''
				Nuestro mundo conoce muchos gusanos de origen cósmico, y estos dos no son la excepción.
				Gracias a su benevolencia, nuestro mundo recibe el regalo del Día y la Noche.
				Son todo lo contrario de los Dioses. Se dedican a nuestro bienestar.
				Las leyendas incluso cuentan que lucharon junto a un héroe para desterrar las fuerzas del Caos.
				Fue ese héroe quien me inspiró a empuñar mi espada y comenzar mi Cruzada.
				'''
		}

		SistersOfDiscordLore: {
			DisplayName: Las Hermanas de la Discordia
			Tooltip: ""
			Lore:
				'''
				Esas dos son una pareja bastante irritante.
				No me cabe duda de que la callada lleva un tiempo espiando las operaciones de la Cruzada.
				Del mismo modo, la maga ha atacado a mis tropas en varias ocasiones. He oído que desea enfrentarse a la Bruja de Azufre en un combate uno contra uno.
				Dudo que sobrevivieran a un encuentro así incluso trabajando en equipo.
				'''
		}

		AkumaLore: {
			DisplayName: Akuma
			Tooltip: ""
			Lore:
				'''
				El Demonio Draconiano...
				Cualquier intento de mis fuerzas por adentrarse en el Infierno era repelido rápidamente por sus llamas.
				Él fue el responsable del Infierno, que nació de sus llamas y arrasó con la civilización que una vez llamó hogar a la región.
				Cuidado: tu victoria aquí solo es temporal. El espíritu furioso de Akuma aún perdura.
				Y me temo que su verdadero poder sigue dormido... Esperando ser despertado.
				'''
		}

		YamataLore: {
			DisplayName: Yamata
			Tooltip: ""
			Lore:
				'''
				La Pesadilla Funesta...
				Mis fuerzas no se atrevían a entrar en el Cenagal; sus viles toxinas acababan con cualquiera que lo hiciera.
				Fue él el responsable del Cenagal: nació de sus toxinas, que asfixiaron a la civilización que una vez llamó hogar a la región.
				Cuidado: tu victoria aquí solo es temporal. El alma colérica de Yamata aún persiste.
				Y me temo que su verdadero poder sigue dormido... Esperando ser despertado.
				'''
		}

		ZeroLore: {
			DisplayName: Zero
			Tooltip: ""
			Lore:
				'''
				El Constructo del Fin del Mundo...
				Draedon llevaba mucho tiempo fascinado por esta unidad. Sus escudos repelieron cada uno de sus intentos de atravesarlos.
				Parece que solo tú fuiste capaz de activarla.
				Ten cuidado.
				Esa señal de auxilio, si hay que creer en la investigación de Draedon sobre esa anomalía...
				Has invitado al desastre a nuestra puerta.
				'''
		}

		ChampionRajahRabbitLore: {
			DisplayName: El Campeón de los Inocentes
			Tooltip: ""
			Lore:
				'''
				Pensaba que el tiempo de Rajah como Campeón de los Inocentes duraría mucho más que el mío, pero me equivocaba.
				Ahora tú ostentas su título y él se retira, igual que yo.
				Derrotarlo en su máximo poder no es poca cosa; quizá ya estés listo para enfrentarte incluso a mí.
				Sal victorioso de tus próximas batallas y ese momento no tardará en llegar.
				'''
		}

		ShenDoragonLore: {
			DisplayName: Shen Doragon
			Tooltip: ""
			Lore:
				'''
				Pensar que Akuma y Yamata no eran más que dos mitades de un mismo ser...
				Aun así, no puedo evitar dudar que eso fuera todo de lo que era capaz.
				En relatos antiguos, he oído la historia de un héroe que luchó contra la Discordia Encarnada.
				Sin embargo, ese relato no describía a un dragón, sino a un hombre... Qué curioso...
				'''
		}

		InfinityZeroLore: {
			DisplayName: Cero Infinito
			Tooltip: ""
			Lore:
				'''
				El conocimiento del Asesino del Infinito era lo más lejos que había llegado la investigación de Draedon sobre la anomalía.
				Pensar que era tan poderoso y que no era más que una carcasa para una amenaza aún mayor.
				Olvido... Me temo que ya había oído ese nombre, en antiguos textos que describían la creación de nuestro universo.
				Cuatro Titanes de poder inconmensurable...
				¿Podría ser esta la encarnación de la Entropía de la que hablaban...?
				'''
		}

		SoulOfCthulhuLore: {
			DisplayName: Alma de Cthulhu
			Tooltip: ""
			Lore:
				'''
				La caída de los dragones... ¿Podría ser que no hubiera un solo behemot aberrante, sino dos...?
				Si hemos de creer a ese espíritu sobrenatural, así debió ser; pero ¿por qué me ocultarían la historia de este...?
				En mis estudios del idioma de los Dragones, aprendí que 'Cthulhu' significa 'Gran Bestia'.
				Quizá este gemelo fuera la inspiración de semejante apelativo...
				'''
		}
	}
}

InfinityGauntlet: {
	DisplayName: Guantelete del Infinito
	Tooltip: ""
}

TimeStone: {
	DisplayName: Piedra del Tiempo
	Tooltip: ""
