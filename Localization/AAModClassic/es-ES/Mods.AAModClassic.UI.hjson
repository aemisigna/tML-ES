}

Unreleased: {
	Title: No Lanzado
	Description: Experimenta contenido nunca antes visto de compilaciones en desarrollo.
}

Unofficial: {
	Title: Oficial
	Description: Disfruta de una experiencia más suave con mejoras y nuevas adiciones.
}

WindowTitle: {
