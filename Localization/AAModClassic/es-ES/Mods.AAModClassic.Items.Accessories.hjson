AleisterBook: {
	DisplayName: Libro de Aleister
	Tooltip:
		'''
		Un libro legendario del Mega Therión.
		Aumento del 10% al daño de súbditos
		+2 espacios de súbdito
		Quizás podrías hacerlo más fuerte..?
		Hay una nota escrita en la portada:
		Necesito almas más poderosas, *****,*********,**********
		'''
}

TheBookOfTheLaw: {
	DisplayName: El Libro de la Ley
	Tooltip:
		'''
		Un libro legendario del Mega Therión.
		Aumento del 30% al daño de súbditos
		+2 espacios de súbdito
		Incluye los efectos de todas las piezas utilizadas para hacerlo.

		'''
}

