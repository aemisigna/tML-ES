	RangedDamageClass: a distancia
	MagicDamageClass: magia
	SummonDamageClass: invocaciones
	SummonMeleeSpeedDamageClass: "{$EquipStats.ClassGlobalStats.SummonDamageClass}"
	MagicSummonHybridDamageClass: magia e invocaciones
	ThrowingDamageClass: lanzamiento
	CritChance: "{0}% {1} {2}{3}probabilidad de golpe crítico"
	AttackSpeed: "{0}% {1} {2}{3}velocidad"
	ArmorPenetration: "{0} {1}{2}penetración de armadura por {3}"

	StatModifier: {
		Adlibs: {
			EverySingleClassExceptSummoner: {
				Base: "{0} {1} {2}{3}{4}"
				Additive: "{0}% {1} {2}{3}{4}{5}"
				Multiplicative: "{2}{3}{4} multiplicado por {0}%"
				Flat: "{0} {1} plano {2}{3}{4}"
			}

			Summoner: {
				Base: "{1} {2}{3}{4} por {0}"
				Additive: "{1} {2}{3}{4}{5} por {0}%"
				Multiplicative: Multiplica {2}{3}{4} por {0}%
				Flat: "{1} {2}{3}{4} por {0} plano"
			}
		}

		Increases: aumenta
		Decreases: disminuye
		Increased: aumentado
		Decreased: disminuido
		Increase: aumentar
		Decrease: disminuir
		Reduced: reducido
		More: más
		Less: menos
		Damage: daño
		Knockback: retroceso
		CritSameAsDamageAdditive: " & probabilidad de golpe crítico"
	}
}

