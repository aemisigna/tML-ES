Assortegelatin: {
	DisplayName: Assortegelatin
	Tooltip:
		'''
		Invoca babosas para que luchen a tu favor según tu bioma actual
		Todos los babosas salvajes lucharán a tu favor
		Pacifica todos los babosas, incluso jefes
		'''
}

CalamitousSoulArtifact: {
	DisplayName: Resentimiento Sentimental
	Tooltip:
		'''
		Dolor
		Los enemigos eliminados invocaban corazones de azufre estacionarios que explotan después de 10 segundos
		Los corazones también pueden bloquear proyectiles y ser recogidos para recuperar salud
		Otorga un espacio de súbdito por cada súbdito invocado que ocupe múltiples espacios
		Aumenta velocidad de combate en 20%, velocidad de proyectiles en 35%, daño de pícaro en 45%, súbditos máximos en 8, y reduce costo de maná en 75%
		Aumenta el daño según la proximidad al enemigo
		'''
}

CosmicStone: {
	DisplayName: Piedra Cósmica
