		Multiplicador de aceleración: 3.2
		Tiempo de vuelo: ∞
		'''
}

MagnaCore: {
	DisplayName: Núcleo Magna
	Tooltip:
		'''
		30% más daño mágico, 25% más probabilidad de golpe crítico mágico, y 100% menos uso de maná
		+250 maná máximo
		Aumenta el rango de recogida para las estrellas de maná
		Usar una Poción de Maná causa una explosión de energía de granito para atacar enemigos
		'''
}

Microxodonta: {
