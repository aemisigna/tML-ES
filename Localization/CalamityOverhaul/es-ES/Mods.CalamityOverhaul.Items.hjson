Deepclaw: {
	DisplayName: Deepclaw
	Tooltip:
		'''
		Invoca una langosta abisal para luchar por ti
		La langosta se abalanza contra los enemigos con golpes de pinza chasqueantes
		Cada tercer golpe de pinza se echa hacia atrás y detona un chasquido de cavitación
		El chasquido inflige daño de área y arrastra a los enemigos hacia su centro
		«Lo que vive abajo nunca afloja el agarre»
		'''
}

SeaShrimpShell: {
	DisplayName: Caparazón de camarón cristalino
