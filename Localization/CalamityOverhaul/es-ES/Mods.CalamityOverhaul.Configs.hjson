CWRServerConfig: {
	DisplayName: Configuración de contenido
	Headers.CWRWorldGen: Configuración de generación del mundo

	GenWindGrivenGenerator: {
		Label: Generar generador eólico
		Tooltip: Coloca estructuras de generadores impulsados por el viento por el mundo
	}

	GenWGGCollector: {
		Label: Generar puestos de chatarreros
		Tooltip: Genera al azar estructuras hostiles de chatarreros por el mundo. Esta opción solo tiene efecto en mundos legendarios
	}

	GenJunkmanBase: {
		Label: Generar base del chatarrero
		Tooltip: Genera una base fortificada de chatarreros en páramos o bajo tierra
	}

	GenRocketHut: {
		Label: Generar cabaña del cohete
		Tooltip: Genera una cabaña misteriosa con piezas de cohete o reliquias tecnológicas
	}

	GenSylvanOutpost: {
		Label: Generar puesto silvano
		Tooltip: Genera puestos de avanzada de elfos o guardianes del bosque en lo profundo del bosque
	}

	GenSHPCCradle: {
		Label: Generar isla cuna de SHPC
		Tooltip: Genera una isla celeste con una nave estrellada sobre el punto de aparición y la SHPC sellada dentro. Si se desactiva, el arma solo se puede encontrar en el laboratorio de Calamity
	}

	ConfigChangePrefix: Usuario
	ConfigChangeSuffix: ha modificado la configuración del servidor
}

CWRClientConfig: {
	DisplayName: Configuración del cliente

	Headers: {
		CWRWeapon: Configuración de armas
		CWRDisplay: Configuración de visualización
	}

	ScreenVibration: {
		Label: Vibración de pantalla de armas
		Tooltip: Si se activa, la pantalla vibrará durante algunos ataques, lo que puede intensificar la sensación del impacto
	}

	DomainConciseDisplay: {
		Label: Pantalla minimalista de dominios
		Tooltip: Desactivado por defecto. Al activarlo, solo se reducen los efectos visuales de los dominios del Ciberespacio y del Mar. El Dominio Oni de Onikiri no se ve afectado, ni tampoco los efectos de armas y ciberimplantes, como desmembrar, omokage y Tiempo de Hackeo
	}

	HideOtherDomains: {
		Label: Ocultar dominios de otros jugadores
		Tooltip: Activado por defecto. Al activarlo, los efectos visuales de pantalla completa de los dominios abiertos por otros jugadores (el Dominio Oni de Onikiri, el Lago de Sangre de Kikasa, la Lluvia Fantasmal y el Sueño fantasmal) dejan de dibujarse en tu pantalla. Igual seguirán apareciendo si estás dentro de su lago, te arrastran bajo el agua o estás dentro de su sueño. Es solo algo visual, no cambia ningún efecto: tus propios dominios no se ven afectados.
	}

	LensEasing: {
		Label: Suavizado de la cámara
		Tooltip: Al activarlo, los desplazamientos rápidos a larga distancia ralentizarán la cámara, evitando la sensación de moverse demasiado rápido
	}

	AmbienceDensity: {
		Label: Densidad ambiental
		Tooltip: Ajusta únicamente la densidad de las partículas ambientales decorativas; las señales de advertencia y los peligros nunca se reducen
	}

	RarityTextEffects: {
		Label: Efectos de nombre de rareza
		Tooltip: Efectos animados en el nombre de los objetos para las rarezas de este mod (Lapislázuli, Jade, Cobre, Dorado, Plata estelar y las cuatro Leyendas). Si se desactiva, los nombres se dibujan en color plano
	}
}
