	UnpinHint: Haz clic de nuevo en la fila fijada para quitarla
	ConditionLockText: No se cumple la condición
	PinnedTag: Fijada
	PowerUnit: UE
}

Thrower: {
	NoEnergyText: ¡Energía insuficiente!
	NoItemText: ¡No hay objetos para lanzar!
	WorkingText: Lanzando...
	IdleText: En espera
	DisplayName: Lanzador
	Tooltip:
		'''
		Consume electricidad para lanzar objetos
		Clic derecho para abrir el panel de control
		'''
}

PlayerLauncher: {
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Plataforma de lanzamiento
	Tooltip:
		'''
		Consume energía para lanzar a los jugadores que se encuentren encima en la dirección configurada
		Concede una breve inmunidad al daño por caída después del lanzamiento
		Clic derecho para abrir el panel de control
		'''
}

PacifierTower: {
	FieldOnText: Campo activado
	FieldOffText: Campo desactivado
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Generador de campo pacificador
	Tooltip:
		'''
		Suprime la aparición natural de enemigos cercanos mientras recibe energía
		Clic derecho o señal de cable para alternar el campo
		'''
}

PotionBeacon: {
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Baliza difusora de pociones
	Tooltip:
		'''
		Almacena pociones de mejora y difunde continuamente sus efectos a los jugadores cercanos
		Una poción proporciona el doble de su duración original
		Clic derecho para abrir el panel de control
		'''
}

HerbFarmer: {
	NoEnergyText: ¡Energía insuficiente!
	FullText: ¡El almacén de productos está lleno!
	DisplayName: Máquina de cultivo de hierbas
	Tooltip:
		'''
		Consume semillas y energía para plantar automáticamente hierbas en tierra válida cercana
		Cosecha hierbas florecidas y produce hierbas y semillas
		Clic derecho para abrir el panel de control
		'''
}

MushroomFarmer: {
	NoEnergyText: ¡Energía insuficiente!
	FullText: ¡El almacenamiento de productos está lleno!
	DisplayName: Máquina de cultivo de setas
	Tooltip:
		'''
		Consume energía para cultivar hongos en el césped cercano y hongos brillantes en césped fúngico
		Los cosecha automáticamente, produciendo ocasionalmente semillas de césped fúngico
		También corta las enredaderas que cuelgan bajo el césped fúngico; cada segmento tiene un 50% de probabilidad de dar un hongo brillante
		Clic derecho para abrir el panel de control
		'''
}

Apiary: {
	NoEnergyText: ¡Energía insuficiente!
	NoBottleText: ¡No quedan botellas!
	FullText: ¡El almacenamiento de productos está lleno!
	DisplayName: Colmena
	Tooltip:
		'''
		Carga botellas vacías y las abejas prepararán miel embotellada usando energía
		Las abejas trabajan más rápido cerca de la miel o en la jungla
		Clic derecho para abrir el panel de control
		'''
}

SlimeVat: {
	NoEnergyText: ¡Energía insuficiente!
	NoWaterText: ¡No hay suficiente agua!
	FullText: ¡El almacenamiento de productos está lleno!
	PourText: +{0} de agua
	DisplayName: Tina de cultivo de slime
	Tooltip:
		'''
		Consume agua y energía para cultivar gel periódicamente
		Extrae agua de masas adyacentes o vierte cubos a mano
		Clic derecho para abrir el panel de control
		'''
}

AutoFisher: {
	NoEnergyText: ¡Energía insuficiente!
	NoBaitText: ¡No queda cebo!
	NoWaterText: ¡No hay agua pescable cerca!
	FullText: ¡El almacenamiento de capturas está lleno!
	DisplayName: Pescador automático
	Tooltip:
		'''
		Consume cebo y energía para pescar automáticamente en el agua de debajo
		Las masas de agua grandes y los cebos mejores producen capturas más valiosas
		Clic derecho para abrir el panel de control
		'''
}
