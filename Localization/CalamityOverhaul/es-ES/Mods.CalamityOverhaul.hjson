	CrimsonAltar: Altar carmesí
	Tile192: Hojas de madera viva
	Tile187: Malas hierbas
	Tile352: Espinas
}

OniRainWorld: {
	OniRainWorldSystem: {
		InteractHint: "[Clic derecho] Mantén el paraguas bajo la lluvia"
		DescendHint: "[Clic derecho] Mantén el paraguas bajo la lluvia profunda"
		GrabHint: "[Clic derecho] Agarra el paraguas"
		OniDeathReason: "{0} fue arrastrado por la lluvia por la cosa que había bajo el paraguas"
	}
}

GodSmithMagicConduit: {
	GsHeatRay.Desc:
		'''
		Reforjado: mantén para sostener un rayo abrasador; el calor blanco ensancha el haz y las acumulaciones fundidas detonan en la quinta
		Clic derecho para expulsar todo el calor como una lanza de destello de corona
		'''
	GsMedusaHead.Desc:
		'''
		Reforjada: mantén para liberar un cono de mirada petrificante; las acumulaciones de marca pétrea petrifican brevemente y el calor blanco estrecha la mirada hasta convertirla en un resplandor concentrado
		Clic derecho para expulsar todo el calor como un resplandor pétreo de ocho direcciones
		'''

	GsSoulDrain: {
		Desc:
			'''
			Reforjado: un conducto de sanguijuela que ata hasta tres enemigos y los drena juntos; el calor blanco otorga recuperación de vida verdadera
			Clic derecho para detonar la sangre almacenada en tu cursor; la sobrecarga rebota y te quita 10 de vida
			'''
		BloodPriceDeath: "{0} fue drenado por su propio conducto de sanguijuela"
	}
}

GodSmithMagicMorph: {
	GsClingerStaff.Desc:
		'''
		Reforzado: mantén brevemente el clic derecho para colocar un muro de enredaderas malditas de 260px a lo largo de tu puntería, en cualquier ángulo.
		Sobrecárgalo y ambos extremos harán brotar muros verticales laterales
		'''
	GsCrimsonRod.Desc:
		'''
		Reforjada: la nube de sangre se convierte en un campo de lluvia sacrificial.
		Las gotas acumulan Erosión sanguínea; tres acumulaciones estallan y los aliados dentro se regeneran lentamente.
		El clic derecho desplaza el campo hasta tu cursor por una pizca de maná
		'''
	GsCrystalSerpent.Desc:
		'''
		Reforjada: los fragmentos de la explosión rebotan una vez más.
		Mantén el clic derecho para cargar; suelta una gran pitón cristalina que serpentea en una onda sinusoidal y estalla en una lluvia de fragmentos más abundante
		'''
	GsCrystalStorm.Desc:
		'''
		Reforjada: mantén el clic derecho para cargar un vórtice de refracción en el cursor.
		Tus fragmentos cristalinos que lo atraviesan se refractan, ganan velocidad y una penetración adicional
		'''
	GsFlamelash.Desc:
		'''
		Reforjada: el vuelo guiado gira un 25% más rápido.
		Mantén el clic derecho para cargar; suelta una serpiente de llamas cuyas curvas siguen tu guía y prenden fuego a los enemigos
		'''
	GsMagicMissile.Desc:
		'''
		Reforzado: el vuelo guiado gira un 25% más rápido.
		Mantén el clic derecho para cargar; suelta una descarga triple que escolta a tu cursor en formación
		'''
	GsMeteorStaff.Desc:
		'''
		Reforjado: los meteoritos dejan un cráter abrasador al caer.
		Mantén el clic derecho para cargar; suelta para llamar una andanada de cinco meteoritos sobre el cursor
		'''
	GsNimbusRod.Desc:
		'''
		Reforjada: cuando ambas nubes están desplegadas, un corredor de lluvia las conecta, empapando y ralentizando a los enemigos dentro.
		El clic derecho alterna lluvia cálida o tormenta eléctrica; la tormenta hace caer rayos a lo largo del corredor
		'''
	GsRainbowGun.Desc:
		'''
		Reforjada: mientras el arcoíris permanezca, tus proyectiles dentro de la franja sobre el arco infligen un 8% más de daño y el arco libera pulsos prismáticos teledirigidos.
		El clic derecho retira el arcoíris y devuelve la mitad de su maná
		'''
	GsRainbowRod.Desc:
		'''
		Reforjada: los virotes guiados estallan en fragmentos prismáticos al impactar.
		Mantén el clic derecho para cargar; suelta para levantar un puente arcoíris que daña a los enemigos que lo cruzan y acelera a los aliados que permanecen sobre él
		'''
	GsSkyFracture.Desc:
		'''
		Reforjada: las hojas desgarran un destello de fractura al salir.
		Mantén el clic derecho para cargar; suelta para abrir tres abismos alrededor del cursor que liberan hojas convergentes
		'''
}

GodSmithSummonWhips: {
	GsCoolWhip.Desc: Reforjada: los copos de nieve nacidos de latigazos a tiempo crecen y atraviesan a un enemigo más; 4 cicatrices de escarcha sellan la marca y el siguiente golpe a tiempo la hace florecer en una explosión de escarcha que inflige Congelación
	GsDarkHarvest.Desc: Reforjada: los saltos de energía oscura se extienden a enemigos cercanos por cada cicatriz de siega de la víctima; 4 cicatrices sellan la marca y el siguiente golpe a tiempo siega su alma, lanzando guadañas contra todos los enemigos marcados del campo
	GsDurendal.Desc: Reforjada: después de tres latigazos a tiempo, cada golpe posterior libera una onda de espada dorada desde la punta del látigo; 5 cicatrices sellan la marca y el siguiente golpe a tiempo hace caer una hoja de veredicto sagrado
	GsFirecracker.Desc: Reforjado: conserva la explosión clásica detonada por súbditos; los latigazos a tiempo cargan fusibles en el objetivo y, con 3 fusibles, la siguiente explosión encadena 3 explosiones adicionales escalonadas
	GsKaleidoscope.Desc: Reforjado: tiene la ventana de ritmo más estrecha y un golpe fallido reinicia todo el tempo; cada cicatriz enciende un color prismático y, con cinco colores, el siguiente golpe a tiempo despliega un caleidoscopio de cinco tajos prismáticos, exponiendo a la víctima a golpes críticos garantizados durante 5s
	GsLeatherWhip.Desc: Reforjado: encadena golpes al ritmo para acumular tempo y velocidad de latigazo; 3 cicatrices de látigo sellan la marca y el siguiente golpe a tiempo la rompe con un 200% de daño, después tus súbditos despedazan al objetivo durante 2s
	GsMorningStar.Desc: Reforjada: cada golpe a tiempo estampa un terremoto en la punta del látigo; 3 cicatrices sellan la marca y el siguiente golpe a tiempo hace caer una maza estelar sobre la cabeza del objetivo
	GsSnapthorn.Desc: Reforjada: los latigazos a tiempo hacen crecer cicatrices de espinas en la presa; 4 cicatrices sellan la marca y el siguiente golpe a tiempo la hace estallar en una explosión de espinas más 4 púas venenosas teledirigidas
	GsSpinalTap.Desc: Reforjado: un barrido a tiempo que marca a 3 enemigos produce un eco óseo que alcanza todo lo que no golpeó; 4 cicatrices sellan la marca y el siguiente golpe a tiempo hace brotar una espina de hueso desde abajo
}

GodSmithAcc.GodSmithSharkToothNecklace.EffectDesc:
	'''
	+4% de daño
	Los golpes desgarran la piel del objetivo y otorgan Desgarro: +1 de penetración de armadura por acumulación, hasta 8 acumulaciones, dura 3s
	'''

