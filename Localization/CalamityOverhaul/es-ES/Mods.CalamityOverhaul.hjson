# For Language Pack Creators:
# The keys here were previously in Items. Since EcTypeItem has been removed, all localization keys similar to "ItemNameEcType" have been moved here.
# The corresponding format is "ItemNameEcType" → "RItemName" or "ItemNameOverride".
# Apart from the class name change, the DisplayName and Tooltip remain the same as in the previous version.
# So if you need to migrate your language pack to the new version, simply copy and paste the entries here and update the class names accordingly.

Arcanes: {
	Items: {
		ArcaneTransformer: {
			DisplayName: Transformador arcano
			Tooltip: ""
		}
	}
}

Resurrections: {
	ResurrectionDeath: {
		DeathText: "{0} murió por la Resurrección del Abismo"
		WarningCombatText: El Abismo te está consumiendo...
		DeathNoticeText: Has sido consumido por el Abismo...
		MarkRemainText: La marca del Abismo aún te envuelve...
		RetainValueFormat: Valor de resurrección: {0}%
	}
}

QuickHack: {
	SynapseBurn: {
		DisplayName: Quemadura sináptica
		Description: Sobrecarga las sinapsis neuronales del objetivo, infligiendo daño térmico continuo.
	}

	ShortCircuit: {
		DisplayName: Cortocircuito
		Description: Libera un pulso electromagnético que inflige daño instantáneo y una breve parálisis.
	}

	Cyberpsychosis: {
		DisplayName: Ciberpsicosis
		Description: Sumerge al objetivo en un frenesí y lo hace atacar a todas las unidades cercanas.
	}

	SystemReset: {
		DisplayName: Reinicio del sistema
		Description: Fuerza un reinicio del sistema del objetivo, paralizándolo por completo.
	}

	OpticOverload: {
		DisplayName: Sobrecarga óptica
		Description: Ciega al objetivo, impidiéndole percibir su entorno.
	}

	MemoryWipe: {
		DisplayName: Borrado de memoria
		Description: Borra los datos de hostilidad del objetivo y restablece su lista de agresión.
	}

	Contagion: {
		DisplayName: Propagación
		Description: Implanta un programa malicioso autorreplicante que se extiende a objetivos cercanos.
	}

	TileDetonate: {
		DisplayName: Detonación de bloques
		Description: Compromete la integridad estructural y provoca una explosión localizada.
	}

	TilePhase: {
		DisplayName: Protocolo de virtualización
		Description: Altera las propiedades físicas de un bloque, volviéndolo intangible durante un tiempo.
	}

	TileMagPull: {
		DisplayName: Atracción magnética
		Description: Genera un campo magnético que atrae hacia ti los objetos caídos cercanos.
	}

	MachineShortCircuit: {
		DisplayName: Cortocircuito mecánico
		Description: Vacía la energía eléctrica de la máquina objetivo y libera arcos eléctricos que dañan entidades cercanas.
	}

	TurretHijack: {
		DisplayName: Secuestro de torreta
		Description: Altera el módulo de identificación amigo-enemigo, invirtiendo temporalmente la lealtad de la torreta.
	}

	FalseMemory: {
		DisplayName: Falso recuerdo
		Description: Implanta recuerdos falsos, interrumpiendo brevemente la persecución o suprimiendo su patrón asesino.
	}

	SelfDismember: {
		DisplayName: Autodesmembramiento
		Description: Obliga a la entidad paranormal a desmembrarse a sí misma.
	}

	SystemHalt: {
		DisplayName: Bloqueo del sistema
		Description: Sumerge al objetivo en un silencio temporal y detiene toda actividad.
	}

	TurretCircuitOverload: {
		DisplayName: Sobrecarga de circuito
		Description: Inyecta corriente inversa en el circuito de alimentación de la torreta, dejándola totalmente inoperativa durante mucho tiempo.
	}

	TurretShortCircuit: {
		DisplayName: Cortocircuito de torreta
		Description: Descarga al instante la energía de la torreta para un breve parón; vuelve a activarse en cuanto se recupera.
	}

	VirusBroadcast: {
		DisplayName: Difusión viral
		Description: Inyecta código gusano en la torre de señales, provocando ondas EMP cibernéticas que cortocircuitan todas las torretas a su alcance durante mucho tiempo.
	}

	MeltdownProtocol: {
		DisplayName: Protocolo de fusión
		Description: Bloquea los disipadores de calor del objetivo; cuatro segundos después se sobrecalienta y alcanza a los enemigos cercanos.
	}

	ProjectileHijack: {
		DisplayName: Toma de control balística
		Description: Reasigna un proyectil entrante y lo devuelve por el mismo camino.
	}

	ProjectileFreeze: {
		DisplayName: Congelación balística
		Description: Fija un proyectil en el aire durante cinco segundos y luego lo deja continuar.
	}

	DataPurge: {
		DisplayName: Purga de datos
		Description: Borra un proyectil entrante y todos los cercanos del mismo tipo.
	}

	BallisticOverclock: {
		DisplayName: Sobrecarga balística
		Description: Añade daño, penetración y tiempo de vuelo a uno de tus propios proyectiles.
	}

	Electrolysis: {
		DisplayName: Electrólisis
		Description: Hace pasar corriente por el líquido; los enemigos que se empapen reciben daño con el tiempo.
	}

	Cryostasis: {
		DisplayName: Criostasis
		Description: Congela una porción de líquido y la convierte en hielo sobre el que puedes caminar durante ocho segundos.
	}

	LiquidPurge: {
		DisplayName: Purga de líquidos
		Description: Drena el líquido circundante. También funciona con lava.
	}

	ItemRecall: {
		DisplayName: Recuperación remota
		Description: Arrastra un objeto caído hasta tus pies.
	}

	Reappraise: {
		DisplayName: Reevaluación
		Description: Vuelve a generar el prefijo del equipo que está en el suelo.
	}

	ArmorParse: {
		DisplayName: Análisis de armadura
		Description: Reduce la defensa del objetivo a cero durante seis segundos.
	}

	Exorcise: {
		DisplayName: Eliminación forzada
		Description: Marca al objetivo para eliminarlo; el quinto golpe que reciba activa un golpe pesado.
	}

	DataLeech: {
		DisplayName: Drenaje de datos
		Description: Mientras está activo, golpear a este objetivo restaura tu RAM hasta alcanzar un límite total.
	}

	SwarmLink: {
		DisplayName: Enlace de enjambre
		Description: Golpear al objetivo también inflige un treinta por ciento a hasta cinco enemigos cercanos.
	}

	MachineOverclock: {
		DisplayName: Sobrecarga de máquina
		Description: Alimenta la máquina con una cantidad fija de carga durante diez segundos y después la quema por completo.
	}

	GridBlackout: {
		DisplayName: Apagón de red
		Description: Usa la torre de señales para cortar la energía de todas las máquinas en un radio amplio.
	}

	PowerTransmute: {
		DisplayName: Transmutación de energía
		Description: Convierte en RAM la carga almacenada del objeto que sostienes y luego lo drena por completo
	}

	NeuralOverclock: {
		DisplayName: Sobrecarga neuronal
		Description: Golpea más rápido durante ocho segundos; la recuperación de RAM se detiene y tu salud arde
	}

	WraithForceDrive: {
		DisplayName: Impulso de fuerza espectral
		Description: Las acciones del espectro no cuestan nada durante diez segundos; después la erosión se profundiza y se duerme
	}

	IndexPreread: {
		DisplayName: Prelectura del índice
		Description: Lee todo el inventario de un contenedor sin abrirlo y marca la entrada más valiosa
	}

	LockBurn: {
		DisplayName: Forzado de cerradura
		Description: Abre este contenedor cerrado sin llave, a cambio de quemar un objeto de su interior
	}

	DielSkip: {
		DisplayName: Salto diurno
		Description: Adelanta el tiempo hasta el amanecer o el anochecer más cercano
	}

	StormInject: {
		DisplayName: Inyección de tormenta
		Description: Invoca una tormenta; los rayos solo golpean a los enemigos que tengan cualquier efecto de hackeo
	}

	GravityInvert: {
		DisplayName: Inversión de gravedad
		Description: Invierte la gravedad a tu alrededor; los enemigos y objetos caídos ascienden
	}

	SegmentDelink: {
		DisplayName: Desvinculación de segmento
		Description: El daño a este segmento solo se registra; un 60% se aplica al anclaje al expirar
	}

	LimbSeizure: {
		DisplayName: Inmovilización de extremidades
		Description: Vuelve esta extremidad contra su propio anclaje durante ocho segundos
	}

	CommandLinkCut: {
		DisplayName: Corte del enlace de mando
		Description: Corta su enlace con sus aliados; lucharán solos durante diez segundos
	}

	MunitionSwap: {
		DisplayName: Intercambio de munición
		Description: La torreta dispara munición de tu inventario e inflige tu daño
	}

	TurretMesh: {
		DisplayName: Malla de torretas
		Description: Enlaza las torretas cercanas en una sola descarga hacia tu cursor, con cuarenta disparos en total
	}

	BeaconForge: {
		DisplayName: Forja de balizas
		Description: La torre finge una llamada de auxilio y atrae enemigos de un área amplia
	}

	PrivilegeEscalate: {
		DisplayName: Escalada de privilegios
		Description: Los protocolos cuestan menos, se cargan más rápido e ignoran el alcance; la RAM deja de recuperarse
	}

	ItemSalvage: {
		DisplayName: Desguace
		Description: Descompone este objeto caído para recuperar aproximadamente un 60% de sus materiales
	}

	DataBrand: {
		DisplayName: Marca de datos
		Description: Copia el modificador de este equipo y estampa la copia en el siguiente objetivo
		HudTag: Marca: {0}
		DenyNoPrefix: No hay nada que copiar en este objeto
		DenyIncompatible: El modificador registrado no es compatible con este objeto
	}

	EntityMasquerade: {
		DisplayName: Suplantación
		Description: Los enemigos interpretan este objeto caído como si fueras tú; atraerá sus disparos durante treinta segundos
	}

	TileConscript: {
		DisplayName: Incorporación de bloques
		Description: Arranca bloques cercanos y los convierte en ocho placas de armadura que orbitan a tu alrededor; se lanzan cuando se acaba el tiempo
	}

	VeinResonance: {
		DisplayName: Resonancia de vetas
		Description: Revela minerales coincidentes a través de las paredes; minarlos produce el doble, pero llama a los guardianes
	}

	StressInvert: {
		DisplayName: Inversión de tensión
		Description: Vuelve irrompible este terreno durante diez segundos; los enemigos que choquen contra él reciben daño
	}

	PressureSurge: {
		DisplayName: Oleada de presión
		Description: Presuriza este líquido; todo lo que se empape en él saldrá disparado hacia el cielo
	}

	MirrorSurface: {
		DisplayName: Superficie reflectante
		Description: La superficie se convierte en un espejo; los disparos enemigos que la atraviesan se copian en tu lado
	}

	DelayFuse: {
		DisplayName: Fusible retardado
		Description: Este proyectil deja de expirar y flota en el sitio durante treinta segundos como una mina
	}

	ProjectileTithe: {
		DisplayName: Diezmo de proyectiles
		Description: Este disparo absorbe el fuego enemigo cercano y después detona según cuánto haya tragado
	}

	ProjectileSample: {
		DisplayName: Muestra de proyectil
		Description: Analiza este disparo; durante veinte segundos, uno de cada doce disparos tuyos lo reproducirá
	}

	CompensationProtocol: {
		DisplayName: Protocolo de compensación
		Description: Adelanta un 10% de la vida del objetivo; mátalo en ocho segundos o paga la deuda tú mismo
	}

	PayloadRewrite: {
		DisplayName: Reescritura de carga útil
		Description: Durante diez segundos, los proyectiles del objetivo se vuelven tuyos e infligen tu daño
	}

	PhaseDesync: {
		DisplayName: Desincronización de fase
		Description: Separa el cuerpo del objetivo de su hitbox; ambos lados se vuelven más difíciles de golpear
	}

	LiveCellTap: {
		DisplayName: Extracción de célula viva
		Description: Fija al objetivo, lo vuelve inmune y convierte su vida en tu RAM
	}

	FirmwareRollback: {
		DisplayName: Reversión de firmware
		Description: Devuelve al objetivo a su fase anterior; después se vuelve frenético durante cinco segundos
	}

	ShellRequisition: {
		DisplayName: Requisición de carcasa
		Description: Los objetivos que mueren marcados se levantan de nuevo y luchan por ti durante quince segundos
	}

	PositionCast: {
		DisplayName: Proyección de posición
		Description: La posición de los enemigos será visible para todo tu equipo a través de las paredes durante quince segundos
	}

	GaugePollution: {
		DisplayName: Contaminación de lecturas
		Description: Corrompe su interfaz; las lecturas de salud y munición se alteran durante ocho segundos
	}

	LinkTraceback: {
		DisplayName: Rastreo inverso del enlace
		Description: Corta todas las cargas dirigidas hacia ti, quema a sus emisores y los marca
	}

	ForceUninstall: {
		DisplayName: Desinstalación forzada
		Description: Arranca un protocolo hostil de ti; no puedes arrancar otro durante medio minuto
	}

	MemoryScorch: {
		DisplayName: Quemadura de memoria
		Description: Quema tres unidades de su RAM al impactar; su recuperación permanece en cero durante diez segundos
		SealTag: RAM SELLADA
	}

	BuffSiphon: {
		DisplayName: Drenaje de mejoras
		Description: Te roba la mejora que más tiempo lleva activa, hasta treinta segundos
	}

	CombatSiphon: {
		DisplayName: Drenaje de combate
		Description: Durante diez segundos, el daño que les infliges se convierte en tu RAM
	}

	BallisticTurncoat: {
		DisplayName: Traición balística
		Description: Sus tres siguientes disparos se dan la vuelta en pleno vuelo y persiguen a su dueño; mantener el fuego a salvo los protege
		HijackCounter: SECUESTRADO {0}/{1}
		DeathReason: El disparo de {0} fue desviado por {1} y volvió a casa.
	}

	MeltdownBrand: {
		DisplayName: Marca de fusión
		Description: Coloca un fusible visible de cuatro segundos que detona e inflige ochenta de daño; desinstalarlo desactiva la carga
		FuseTag: FUSIÓN {0}s
		DeathReason: "{0} fue despedazado por la marca de fusión colocada por {1}."
	}

	MapBlackout: {
		DisplayName: Apagón del mapa
		Description: Cubre su mapa de estática durante quince segundos, incluidos los marcadores y las marcas del equipo
	}

	ChannelScramble: {
		DisplayName: Distorsión del canal
		Description: Distorsiona su chat durante veinte segundos y borra de su pantalla los nombres de sus compañeros
	}

	StealthStrip: {
		DisplayName: Supresión del sigilo
		Description: Elimina toda su invisibilidad y sigilo durante diez segundos; su contorno brilla para todos
	}

	CooldownInject: {
		DisplayName: Inyección de enfriamiento
		Description: Ralentiza el uso de objetos un 35% durante seis segundos; añade cinco más al enfriamiento de pociones activo
	}

	CyberwareOffline: {
		DisplayName: Ciberware desconectado
		Description: Desconecta todo su ciberware durante ocho segundos
	}
}

