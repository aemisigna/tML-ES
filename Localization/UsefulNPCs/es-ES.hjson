Mods: {
	UsefulNPCs: {
		Configs: {
			UsefulConfig: {
				dealer: {
					Label: Activa al Traficante, un PNJ que vende objetos del Mercader Ambulante, el Mercader Esquelético y Papá Noel
					Tooltip: ""
				}

				builder: {
					Label: Activa al Constructor, un PNJ que vende varios bloques de construcción
					Tooltip: ""
				}

				hephaestus: {
					Label: Activa a Hefesto, un PNJ que vende varios minerales, gemas y tesoros
					Tooltip: ""
				}

				alchemist: {
					Label: Activa al Alquimista, un PNJ que vende varias pociones e ingredientes para pociones
					Tooltip: ""
				}

				martian: {
					Label: Activa al Marciano, un PNJ que vende monturas, llaves de bioma y objetos del modo experto
					Tooltip: ""
				}

				oldChampion: {
					Label: Activa al Viejo Campeón, un PNJ que vende invocadores para jefes, minijefes, enemigos raros y objetos raros
					Tooltip: ""
				}

				shootingStar: {
					Label: Activa a Estrella Fugaz, un PNJ que vende varias cajas de música
					Tooltip: ""
				}

				DisplayName: Configuración de Useful PNJ
			}
		}

		Items: {
			AstronautsHelmet: {
				DisplayName: Casco de Astronauta
				Tooltip: Para todos los PNJs conceptuales que no lo lograron
			}

			Calcium: {
				DisplayName: Calcio
				Tooltip:
					'''
					"Bueno para tus huesos"
