			}

			MartianProbe: {
				DisplayName: Llamador Marciano
				Tooltip: Invoca marcianos
			}

			AdventurersGlasses: {
				DisplayName: Gafas del Aventurero
				Tooltip:
					'''
					"Lamentablemente están rotas"
					Invoca al Doctor Látigo
					'''
			}

			BoneLeesBelt: {
				DisplayName: Cinturón de Hueso Lee
				Tooltip:
					'''
					"El símbolo de su maestría"
					Invoca a Hueso Lee
					'''
			}

			BurningCore: {
				DisplayName: Núcleo Ardiente
				Tooltip:
					'''
					"Caliente al tacto"
					Invoca al elemental de arena
					'''
			}

			EmptyChest: {
				DisplayName: Cofre Vacío
				Tooltip:
					'''
					"Es un señuelo"
					Invoca a un cofre falso
					'''
			}

			FakeRocketLauncher: {
				DisplayName: Lanzacohetes Falso
				Tooltip:
					'''
					"Es solo un juguete"
					Invoca al esqueleto comando
					'''
			}

			FakeSniperRifle: {
				DisplayName: Rifle de Francotirador Falso
				Tooltip:
					'''
					"Es solo un juguete"
					Invoca al esqueleto francotirador
					'''
			}

			FakeTacticalShotgun: {
				DisplayName: Escopeta Táctica Falsa
				Tooltip:
					'''
					"Es solo un juguete"
					Invoca al esqueleto táctico
					'''
			}

			FrozenCore: {
				DisplayName: Núcleo Congelado
				Tooltip:
					'''
					"Frío al tacto"
					Invoca al gólem de hielo
					'''
			}

			MagicHat: {
				DisplayName: Sombrero Mágico
				Tooltip:
					'''
					"Aumenta el daño mágico en un 0%"
					Invoca a Tim
					'''
			}

			MagicSingularity: {
				DisplayName: Singularidad Mágica
				Tooltip:
					'''
					"Atrae magia muy poderosa"
					Invoca al mago rúnico
					'''
			}

			MissingPoster: {
				DisplayName: Cartel de Desaparecida
				Tooltip:
					'''
					"¿Dónde está ella?"
					Invoca a la niña perdida
					'''
			}

			MothPheromone: {
				DisplayName: Feromona de Polilla
				Tooltip:
					'''
					"Atrae polillas"
					Invoca a una polilla
					'''
			}

			PaladinSymbol: {
				DisplayName: Símbolo del Paladín
				Tooltip:
					'''
					"Un símbolo sagrado"
					Invoca al paladín
					'''
			}

			PinkJelly: {
				DisplayName: Gelatina Rosa
				Tooltip:
					'''
					"¡Parece deliciosa!"
					Invoca al slime rosa
					'''
			}

			RainbowJelly: {
				DisplayName: Gelatina Arcoíris
				Tooltip:
					'''
					"¡Parece deliciosa!"
					Invoca al slime arcoíris
					'''
			}

			ScoutEmblem: {
				DisplayName: Emblema de Explorador
				Tooltip:
					'''
					"Huele fatal"
					Invoca al duende explorador
					'''
			}

			StickyKey: {
				DisplayName: Llave Pegajosa
				Tooltip:
					'''
					"No sirve para abrir cofres"
					Invoca al slime de la mazmorra
					'''
			}
		}

