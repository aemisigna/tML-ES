UI: {
	Min: Mín Todo
	MinDescription:
		'''
		Establece todas las configuraciones a los valores que reducirían más la generación.
		Así, un valor como "máximo de árboles" se establecería a su mínimo,
		pero un valor para "probabilidad de árbol (1/x)" se establecería a su máximo.
		'''
	Max: Máx Todo
	MaxDescription:
		'''
		Establece todas las configuraciones a los valores que aumentarían más la generación.
		Así, un valor como "máximo de árboles" se establecería a su máximo,
		pero un valor para "probabilidad de árbol (1/x)" se establecería a su mínimo.
		'''
	Preset: Preconfiguración:
	NoPresets: (Sin preconfiguraciones)
	None: Ninguno
	Reset: Reiniciar
	ResetAll: Reiniciar Todo
	Prior: Anterior:
	Next: Siguiente:
	True: Activado
	False: Desactivado
	Total: "{0} total"
	CustomPresetTooltip: ¡Esto es una preconfiguración personalizada!
	Create: Guardar como preconfiguración personalizada
	CantSave: (No puedes guardar una preconfiguración por defecto)
	Load: Cargar una preconfiguración personalizada
	HoverDescription: Abre para configurar aspectos específicos de la generación de Spirit Reforged.
	FailedToLoad: La preconfiguración no es para esta página. Página esperada: {0}
	ConfigNotice:
		'''
		Los [c/AAAAFF:Rangos] funcionan estableciendo el mínimo y una adición aleatoria.
		El valor mostrado es el rango real utilizado en el juego al tirar aleatoriamente.
		'''
	LoadError: Se ha producido un error al cargar una preconfiguración ({0}). Reporta esto al Discord (y revisa client.log):
	Duplicate: (Preconfiguración duplicada no añadida)
}

Pages: {
	Savanna: {
		Name: "{$Ecotones.SavannaEcotone}"
		Description: Controla aspectos específicos de la generación del ecotono Sabana.

		Presets: {
			Domesticated: {
				Name: "[i:224] Domesticada"
				Tooltip: Una sabana más habitada con más macetas y menos vida silvestre.
			}

			Infested: {
				Name: "[i:SpiritReforged/TermiteJar] Infestada"
				Tooltip: ¡Vaya! ¡Pura termitas! Los árboles pueden ser difíciles de encontrar.
			}

			Bumpy: {
				Name: "[i:SpiritReforged/Drypowder] Accidentada"
				Tooltip: ¡Cuidado dónde pisas! Baches y colinas te esperan en esta Sabana silvestre.
			}
		}

		Members: {
			OverSpawn: {
				DisplayName: "[i:50] Sobre Spawn"
				Tooltip: Si la sabana debe generar sobre el spawn, como la semilla "savanna".
			}

			Steps: {
				DisplayName: "[i:SpiritReforged/DrywoodPlatformItem] Escalones"
				Tooltip: El número de escalones planos que genera la Sabana.
			}

			CampsiteChance: {
				DisplayName: "[i:SpiritReforged/SavannaCampfireItem] Probabilidad de Campamento"
				Tooltip: El denominador (1/x) de la probabilidad de que un campamento aparezca.
			}

			BaseTreeChance: {
				DisplayName: "[i:27] Probabilidad de Árbol Acacia"
				Tooltip:
					'''
					El denominador (1/x) de la probabilidad de que un árbol aparezca en una baldosa dada.
					Esta probabilidad aumenta hasta que se coloca un árbol, y luego se reinicia.
					'''
			}

			PotChance: {
				DisplayName: "[i:SpiritReforged/CommonPotsSavannaItem] Probabilidad de Maceta"
				Tooltip:
					'''
					El denominador (1/x) de la probabilidad de que una maceta aparezca al decorar.
					Esto no anula las baldosas, así que un valor de uno NO colocará una maceta en cada baldosa.
					'''
			}

			TermiteChance: {
				DisplayName: "[i:SpiritReforged/TermiteJar] Probabilidad de Termita"
				Tooltip: El denominador (1/x) de la probabilidad de que un montículo de termitas aparezca al decorar.
			}
		}
	}

	SaltFlats: {
		Name: "{$Ecotones.SaltFlatsEcotone}"
		Description: Controla aspectos específicos de la generación del ecotono Salinas.

		Presets: {
			SunkenRuin: {
				Name: "[i:SpiritReforged/CobbledBrickItem] Ruinas Hundidas"
				Tooltip: Las ruinas de una civilización antigua han sido erosionadas y astilladas.
			}

			BlankCanvas: {
				Name: "[i:SpiritReforged/GlidingItem] Lienzo en Blanco"
				Tooltip: Un reflejo vacío e infinito se extiende ante ti.
			}

			Dessicated: {
				Name: "[i:1274] Desecada"
				Tooltip: No hay ni una gota de agua. Todos los árboles se han marchitado.
			}
		}

		Members: {
			OverSpawn: {
				DisplayName: "[i:50] Sobre Spawn"
				Tooltip: Si las Salinas deben generar sobre el spawn, como la semilla "salt".
			}

			RuinQty: {
				DisplayName: "[i:SpiritReforged/CalmingBellItem] Ruinas de Salinas"
				Tooltip: El límite superior de Ruinas de Salinas colocadas. No todas pueden ser colocadas.
			}

			LakeRadius: {
				DisplayName: "[i:206] Radio del Lago"
				Tooltip: El radio para los lagos de Salinas. Radios mayores corresponden a lagos más grandes.
			}

			CaveRadius: {
				DisplayName: "[i:SpiritReforged/SaltWallItem] Radio de Cueva"
				Tooltip: El radio para las cuevas de Salinas. Radios mayores corresponden a cuevas más grandes.
			}

			MaxSteps: {
				DisplayName: "[i:SpiritReforged/SaltBlockReflectiveItem] Máx Escalones"
				Tooltip: El número máximo de llanuras refractivas de Sal dentro de una Salina.
			}

			StupaChance: {
				DisplayName: "[i:SpiritReforged/StoneStupasItem] Probabilidad de Estupa"
				Tooltip:
					'''
					El denominador (1/x) de la probabilidad de que una maceta estupa de piedra aparezca al decorar.
					Esto no anula baldosas existentes, así que un valor de 1 NO colocará una maceta en cada baldosa.
					'''
			}

			TreeChance: {
				DisplayName: "[i:27] Probabilidad de Árbol Muerto"
				Tooltip:
					'''
					El denominador (1/x) de la probabilidad de que un árbol aparezca en una baldosa dada.
					Esta probabilidad aumenta hasta que se coloca un árbol, y luego se reinicia.
					'''
			}
		}
	}

	Surface: {
		Name: Superficie
		Description: Controla aspectos específicos de las adiciones y ediciones de Reforged a la superficie.

		Presets: {
			Whimsical: {
				Name: "[i:SpiritReforged/MidnightApple] Caprichosa"
				Tooltip: Cuevas exuberantes gigantescas, colinas de Pasto Estelar ondulante, campos de trigo tranquilos... ¿qué podría salir mal?
			}

			Treacherous: {
				Name: "[i:SpiritReforged/LeatherBackpack] Traicionera"
				Tooltip: Enormes gargantas pueden puntear el paisaje. ¡No mires hacia abajo!
			}
		}

		Members: {
			HalfWidth: {
				DisplayName: "[i:133] (Cañón) Ancho Medio"
				Tooltip: Controla el ancho medio del montículo de un cañón, si está suficientemente cerca de la superficie.
			}

			MaxDepth: {
				DisplayName: "[i:133] (Cañón) Profundidad Máx"
				Tooltip: Controla la profundidad máxima de un cañón.
			}

			SizeMultiplier: {
				DisplayName: "[i:747] (Karst) Multiplicador de Tamaño"
				Tooltip: Multiplicador del tamaño de todas las operaciones de excavación que realizan los karsts (cuevas exuberantes).
			}

			FieldSize: {
				DisplayName: "[i:SpiritReforged/BotanistHat] (Campo de Trigo) Tamaño del Campo"
				Tooltip: Controla el ancho del campo de trigo de un espantapájaros.
			}

			ButterflyCountMax: {
				DisplayName: "[i:SpiritReforged/ButterflyStaff] (Santuarios de Mariposa) Máx"
				Tooltip: El número máximo de santuarios de mariposa que pueden ser colocados. Puede no colocar todos.
			}

			HeroChance: {
				DisplayName: "[i:SpiritReforged/HerosMemorialStatueItem] (Memorial del Héroe) Probabilidad de Aparición"
				Tooltip: El denominador (1/x) de la probabilidad de que el Memorial del Héroe aparezca.
			}

			MaxStargrassCount: {
				DisplayName: "[i:SpiritReforged/StarPowder] (Pasto Estelar) Conteo de Parches"
				Tooltip: El número máximo de parches de Pasto Estelar que pueden ser colocados. Puede no colocar todos, o pueden solaparse.
			}

			ReforgedCaveWeight: {
				DisplayName: "[i:30] (Cuevas) Peso Personalizado"
				Tooltip: El peso para que una cueva personalizada de Reforged aparezca sobre una cueva vanilla 'montaña'.
			}
		}
	}

	Ocean: {
		Name: Océano
		Description: Controla aspectos específicos del Océano reformado de Reforged.

		Presets: {
			KelpForest: {
				Name: "[i:SpiritReforged/Kelp] Bosque de Algas"
				Tooltip: ¡Puedes ver los campos de algas desde la orilla!
			}

			Volcanic: {
				Name: "[i:SpiritReforged/GravelItem] Volcánico"
				Tooltip: Un océano escarpado y magmático con apenas flora.
			}
		}

		Members: {
			WaterChestCount: {
				DisplayName: "[i:1298] Máx de Cofres de Agua"
				Tooltip: El número máximo de cofres de agua que pueden ser colocados en el océano. Usualmente no colocará todos.
			}

			SunkenTreasureCount: {
				DisplayName: "[i:SpiritReforged/SunkenTreasure] Máx de Tesoro Hundido"
				Tooltip: El número máximo de tesoros hundidos que pueden ser colocados en el océano. Usualmente no colocará todos.
			}

			SandDepth: {
				DisplayName: "[i:169] Profundidad de Arena"
				Tooltip: Qué tan profundo va la arena en el suelo bajo el océano.
			}

			SandRange: {
				DisplayName: "[i:169] Rango de Arena"
				Tooltip: El límite superior del rango añadido aleatoriamente de la Profundidad de Arena en el océano.
			}

			CoralLowChance: {
				DisplayName: "[i:275] Probabilidad de Coral (Baja)"
				Tooltip: El denominador (1/x) para que coral aparezca en los escalones bajos del océano.
			}

			CoralHighChance: {
				DisplayName: "[i:275] Probabilidad de Coral (Alta)"
				Tooltip: El denominador (1/x) para que coral aparezca en el escalón más alto del océano.
			}

			DecorLowChance: {
				DisplayName: "[i:4090] Probabilidad de Decoración (Baja)"
				Tooltip: El denominador (1/x) para que decoración aparezca en los escalones bajos del océano.
			}

			DecorHighChance: {
				DisplayName: "[i:4090] Probabilidad de Decoración (Alta)"
				Tooltip: El denominador (1/x) para que decoración aparezca en el escalón más alto del océano.
			}

			KelpChance: {
				DisplayName: "[i:SpiritReforged/Kelp] Probabilidad de Algas"
				Tooltip: El denominador (1/x) para que algas aparezcan en el océano.
			}

			KelpMaxHeight: {
				DisplayName: "[i:SpiritReforged/Kelp] Altura de Algas"
				Tooltip: La altura máxima, en baldosas, que las algas pueden generar.
			}

			GravelMultiplier: {
				DisplayName: "[i:SpiritReforged/GravelItem] Multiplicador de Tamaño de Grava"
				Tooltip: El modificador del tamaño de los parches de grava oceánica (que incluye piedra magmática).
			}

			Shape: {
				DisplayName: "[i:4460] Forma del Océano"
				Tooltip: La forma que toma el océano.
			}
		}
	}

